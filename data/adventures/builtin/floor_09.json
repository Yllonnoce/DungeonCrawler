      "Lines": {
        "Offer": {
          "Text": "I dropped the Bell of the Deep when I fled the Echoing Barracks. It is worth more than my life, which is why I am not going back for it. Would you?",
          "VoiceId": "607fa01039851a48"
        },
        "Accept": {
          "Text": "Bless you. It should still be lying where I fell.",
          "VoiceId": "e807ec313615e565"
        },
        "Decline": {
          "Text": "Then leave me. Others will come, or they will not.",
          "VoiceId": "76c0e48b204474ce"
        },
        "Complete": {
          "Text": "The Bell of the Deep! I never thought I would hold it again. Here, this is yours now.",
