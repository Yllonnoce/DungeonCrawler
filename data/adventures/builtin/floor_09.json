  "Quests": [
    {
      "Id": "q_contract",
      "Template": "Investigate",
      "Title": "The Council\u0027s Order",
      "Objective": "Gather the torn leaves of a council order from the cisterns and bring them to Crane",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [
          13,
          11,
          7
        ],
        "ClueName": "leaves of the council\u0027s order"
      },
      "GiverNpc": "npc_crane",
      "Reward": {
        "Xp": 250,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three leaves, by my count, soaked and scattered. Bring them here and we shall say no more about it. Paperwork out of its folder makes me unwell.",
          "VoiceId": "abf7c82d8e62580f",
          "Delivery": "weary"
        },
        "Accept": {
          "Text": "Good. Quickly, and do not read them on the way. They are council property and very dull.",
          "VoiceId": "026748ef930e22c8",
          "Delivery": null
        },
        "Decline": {
          "Text": "Then they stay down here getting damp, and so, I suppose, does my peace of mind.",
          "VoiceId": "e2eaff326d10bda4",
          "Delivery": null
        },
        "Complete": {
          "Text": "All three. My hand, under the council\u0027s seal. I\u0027ll keep it, and nobody burns it.",
          "VoiceId": null,
          "Delivery": null
        },
        "Fail": {
          "Text": "Gone soft in the wet, then. Well. The council keeps its own copy, and I know what it says.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Id": "q_grisel",
      "Template": "Decide",
      "Title": "What Grisel Did",
      "Objective": "Answer Grisel Thorn for leaving her crew in the orc\u0027s cages",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_grisel",
      "Reward": {
        "Xp": 200,
        "Table": null
      },
      "Lines": {
        "Offer": {
          "Text": "Don\u0027t look at me like a jury. Say the thing or don\u0027t say it. I\u0027ve carried it since spring; another moment won\u0027t kill me, though plenty else might.",
          "VoiceId": null,
          "Delivery": null
        },
        "Accept": {
          "Text": "Said, then.",
          "VoiceId": "c6937ecaa2651866",
          "Delivery": null
        },
        "Decline": {
          "Text": "Silence is also an answer. A coward\u0027s, but an answer.",
          "VoiceId": "3181bdca1dc6de91",
          "Delivery": null
        },
        "Complete": {
          "Text": "That\u0027s that. The water\u0027s still sour and we\u0027re both still standing in it.",
          "VoiceId": "7531f954c7d1347a",
          "Delivery": null
        },
        "Fail": {
          "Text": "Nothing, then. Fine. The spiders are better company and they bite less.",
          "VoiceId": "7d00ec1f81d0b07f",
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
