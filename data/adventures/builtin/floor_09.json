  "Npcs": [
    {
      "Id": "npc1",
      "Name": "Corvin Shale",
      "Room": 3,
      "VoiceId": "Orus",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "You... you are alive. Thank the depths. Do not come closer with that torch, my eyes are not used to it.",
              "VoiceId": "2e37a8721471c7c5"
            },
            "Choices": [
              {
                "Text": "What happened to you?",
                "Next": "offer",
                "Effect": "None"
              },
              {
                "Text": "It is done.",
                "Next": "done",
                "Effect": "TurnIn"
              },
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "offer",
            "Line": {
              "Text": "I dropped the Bell of the Deep when I fled the Echoing Barracks. It is worth more than my life, which is why I am not going back for it. Would you?",
              "VoiceId": "607fa01039851a48"
            },
            "Choices": [
              {
                "Text": "I will do it.",
                "Next": "accepted",
                "Effect": "AcceptQuest"
              },
              {
                "Text": "Not now.",
                "Next": null,
                "Effect": "DeclineQuest"
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Bless you. It should still be lying where I fell.",
              "VoiceId": "e807ec313615e565"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "The Bell of the Deep! I never thought I would hold it again. Here, this is yours now.",
              "VoiceId": "f3c95a9b58139f36"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          }
        ]
      },
      "QuestId": "quest1"
    }
  ],
