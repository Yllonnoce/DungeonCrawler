  "Npcs": [
    {
      "Id": "npc_crane",
      "Name": "Alderman Hesketh Crane",
      "Room": 3,
      "VoiceId": "Umbriel",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "A progress check, that is all. The council likes a tally. Only \u2014 there are papers blown about these cisterns with my seal on them, and I should very much like them gathered up.",
              "VoiceId": "3c147349ff1d5bcd",
              "Delivery": "weary"
            },
            "Choices": [
              {
                "Text": "We\u0027ll gather your papers.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Gather your own litter, alderman.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Here. Every leaf of it.",
                "Next": "read",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "read",
            "Line": {
              "Text": "Same wording as yours. Same hand. Same seal \u2014 mine, nineteen years old. Four names. A date down and no date up. It says plumbing. They always say plumbing.",
              "VoiceId": "22930f8dc93fc303",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Four names. Whose?",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Keep it. We\u0027ll want it read aloud later.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q_contract",
      "CastId": "cast_crane",
      "Persona": {
        "VoiceStyle": "a plump market alderman, wheezing on the stair, chain of office, jokes to cover the sweat",
        "DefaultDelivery": "weary",
        "Voice": null,
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    },
    {
      "Id": "npc_grisel",
      "Name": "Grisel Thorn",
      "Room": 4,
      "VoiceId": "Aoede",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Watch him read it. He knows the seal. Nineteen years ago I walked my four to the jailers and bought these years with them, and I have spent every one of them down here.",
              "VoiceId": "060c1557d4d05aec",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Nineteen years is paid. It\u0027s forgiven.",
                "Next": "forgiven",
                "Effect": "Choose",
                "Flag": "grisel_forgiven",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "You sold four people. That stands.",
                "Next": "kept",
                "Effect": "Choose",
                "Flag": "grisel_condemned",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "forgiven",
            "Line": {
              "Text": "Forgiven. By plumbers. Well. The spiders never asked and the stone never answered, so you are an improvement on both. I\u0027ll be lower down when you come through.",
              "VoiceId": "07f3777fd5e127a4",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Mind the levers.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "kept",
            "Line": {
              "Text": "Good. I\u0027d not have believed the other thing. Go on down, then, and when you meet me again, remember you had the chance to say otherwise and spent it.",
              "VoiceId": "f31936d437613d71",
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "We\u0027ll remember.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q_grisel",
      "CastId": "cast_grisel",
      "Persona": {
        "VoiceStyle": "nineteen years underground; flat, dry, contrary, speaks to spiders more easily than to people",
        "DefaultDelivery": "calm",
        "Voice": null,
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    }
  ],
  "Quests": [
    {
      "Id": "q_contract",
      "Template": "Investigate",
      "Title": "The Last Four\u0027s Contract",
      "Objective": "Gather the scattered leaves of the old contract from the cisterns and bring them to Crane",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [
          13,
          11,
          7
        ],
        "ClueName": "leaves of the last four\u0027s contract"
      },
      "GiverNpc": "npc_crane",
      "Reward": {
        "Xp": 250,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three leaves, by my count, soaked and scattered. Bring them here and we shall say no more about it. Paperwork out of its folder makes me unwell.",
          "VoiceId": "abf7c82d8e62580f",
          "Delivery": "weary"
        },
        "Accept": {
          "Text": "Good. Quickly, and do not read them on the way. They are council property and very dull.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Then they stay down here getting damp, and so, I suppose, does my peace of mind.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "All three. Yes. Thank you. I shall file them somewhere the water cannot reach.",
          "VoiceId": "fa034ba5b3b632e6",
          "Delivery": null
        },
        "Fail": {
          "Text": "Gone soft in the wet, then. Just as well. Nobody ever profited by reading an old invoice.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Id": "q_grisel",
      "Template": "Decide",
      "Title": "The Unforgiven",
      "Objective": "Answer Grisel Thorn for what she did to the last four",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_grisel",
      "Reward": {
        "Xp": 200,
        "Table": null
      },
      "Lines": {
        "Offer": {
          "Text": "Don\u0027t look at me like a jury. Say the thing or don\u0027t say it. I have waited nineteen years; another moment won\u0027t kill me, though plenty else might.",
          "VoiceId": "5624ff4088ed6199",
          "Delivery": null
        },
        "Accept": {
          "Text": "Said, then.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Silence is also an answer. A coward\u0027s, but an answer.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "That\u0027s that. The water\u0027s still sour and we\u0027re both still standing in it.",
          "VoiceId": "7531f954c7d1347a",
          "Delivery": null
        },
        "Fail": {
          "Text": "Nothing, then. Fine. The spiders are better company and they bite less.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
