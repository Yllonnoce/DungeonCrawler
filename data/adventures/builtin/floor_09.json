  "Npcs": [
    {
      "Id": "npc_crane",
      "Name": "Alderman Hesketh Crane",
      "Room": 3,
      "VoiceId": "Umbriel",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Progress check, that\u0027s all; the council likes a tally. Only, there\u0027s a council paper torn in three and loose about these cisterns. Bring me the leaves, would you? Unread, if you can manage it.",
              "VoiceId": null,
              "Delivery": "weary"
            },
            "Choices": [
              {
                "Text": "We\u0027ll gather your papers.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Gather your own litter, alderman.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Here. Every leaf of it.",
                "Next": "read",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "read",
            "Line": {
              "Text": "\u0027The drain-wardens are to be paid no longer, since the Verger has forbidden anyone to go below.\u0027 Under the council\u0027s seal. And that is my hand. I signed it.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Why stop paying them?",
                "Next": "excuse",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "You sacked your own wardens.",
                "Next": "excuse",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "excuse",
            "Line": {
              "Text": "The Verger had already shut the mines. What use is a warden who can\u0027t go down? So the council stopped paying them. It seemed only sensible at the time.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "They went down anyway. Unpaid.",
                "Next": "after",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Go back up, Crane.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "after",
            "Line": {
              "Text": "I know. They went down after we stopped paying them, and they never came up. I\u0027ll keep this, and nobody burns it. Go on down.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Go back up, Crane.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "q_contract",
      "CastId": "cast_crane",
      "Persona": {
        "VoiceStyle": "a plump market-town alderman; bluster over panic, speaks in clauses, invoices and apologies",
        "DefaultDelivery": "cheerful",
        "Voice": "Umbriel",
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null,
      "Ritualist": false
    },
    {
      "Id": "npc_grisel",
      "Name": "Grisel Thorn",
      "Room": 4,
      "VoiceId": "Aoede",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "The council dropped us once the Verger shut the mines. We went down anyway, unpaid. Then the orc\u0027s things caged my crew, and I ran. Left them there. Say what you think of that, then help me or don\u0027t.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "You were afraid. It\u0027s forgiven.",
                "Next": "forgiven",
                "Effect": "Choose",
                "Flag": "grisel_forgiven",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "You left them to turn. That stands.",
                "Next": "kept",
                "Effect": "Choose",
                "Flag": "grisel_condemned",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": {
              "Member": "Brand",
              "Line": {
                "Text": "Fear does that. What you do after is what counts.",
                "VoiceId": null,
                "Delivery": null
              }
            }
          },
          {
            "Id": "forgiven",
            "Line": {
              "Text": "Forgiven. Well. I\u0027ll not waste it. Find where the orc keeps them caged, and I\u0027ll be there to bring them out.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Mind yourself, Grisel.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "kept",
            "Line": {
              "Text": "Fair. I\u0027d have said the same. Then I\u0027m on my own, and on my own I look after myself. Go on down.",
              "VoiceId": null,
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "We\u0027ll remember.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "q_grisel",
      "CastId": "cast_grisel",
      "Persona": {
        "VoiceStyle": "a drain-warden months alone underground: flat, wry, short sentences, says the worst about herself first",
        "DefaultDelivery": "weary",
        "Voice": "Despina",
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null,
      "Ritualist": false
    }
