  "Npcs": [
    {
      "Id": "npc1",
      "Name": "Sister Wren",
      "Room": 11,
      "VoiceId": "Despina",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Hush. They do not know I am here. If you can help me, I can help you.",
              "VoiceId": "f3a3d974f78e4e72"
            },
            "Choices": [
              {
                "Text": "What happened to you?",
                "Next": "offer",
                "Effect": "None"
              },
              {
                "Text": "It is done.",
                "Next": "done",
                "Effect": "TurnIn"
              },
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "offer",
            "Line": {
              "Text": "The Knifegrinders took everything I had and left me here to rot. Kill every last one of them in the Sunken Camp and I will make it worth your while.",
              "VoiceId": "c747f63a0659215a"
            },
            "Choices": [
              {
                "Text": "I will do it.",
                "Next": "accepted",
                "Effect": "AcceptQuest"
              },
              {
                "Text": "Not now.",
                "Next": null,
                "Effect": "DeclineQuest"
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Then go. And do not be gentle.",
              "VoiceId": "9f1ddb5002c2830d"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "They are dead? All of them? Then perhaps there is justice down here after all. Take this.",
              "VoiceId": "6312c6a1c0e8e68e"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          }
        ]
      },
      "QuestId": "quest1"
    }
