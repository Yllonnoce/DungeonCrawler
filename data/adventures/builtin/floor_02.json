  "Npcs": [
    {
      "Id": "lunette",
      "Name": "Lunette",
      "Room": 1,
      "VoiceId": "Aoede",
      "Script": {
        "Start": "start",
        "Nodes": [
          {
            "Id": "start",
            "Line": {
              "Text": "Oh, adventurers! I seem to have lost my bathhouse maps. Can you find them? I swear I had them just a moment ago.",
              "VoiceId": "8008d40e5caa0838"
            },
            "Choices": [
              {
                "Text": "Of course.",
                "Next": "accept",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "We\u0027re busy.",
                "Next": "decline",
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "It is done.",
                "Next": "turnin",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "accept",
            "Line": {
              "Text": "Wonderful! I\u0027ll sketch a quick diagram... they should be somewhere in the west gallery, the drying room, and the steam hall. I think.",
              "VoiceId": "a1b0053e4da975a6"
            },
            "Choices": [
              {
                "Text": "We\u0027ll be back.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "decline",
            "Line": {
              "Text": "Oh. I\u0027ll just wander then. The acoustics are lovely, at least.",
              "VoiceId": "db4f5f9f14076c08"
            },
            "Choices": [
              {
                "Text": "Goodbye.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "turnin",
            "Line": {
              "Text": "These are... quarantine orders? Not bathhouse maps at all. But they mention a deeper chamber! Perhaps these are worth something after all. Thank you, here\u0027s a little something.",
              "VoiceId": "b7ded5d074562f2e"
            },
            "Choices": [
              {
                "Text": "Take care.",
                "Next": null,
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
