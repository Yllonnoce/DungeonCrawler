  "Npcs": [
    {
      "Id": "npc_maud",
      "Name": "Maud Sorrel",
      "Room": 0,
      "VoiceId": "Gacrux",
      "Script": {
        "Start": "n_sit",
        "Nodes": [
          {
            "Id": "n_sit",
            "Line": {
              "Text": "Forgive the size of me. I have been trying to turn over for three hundred years and a small man keeps his hand across my mouth. Put down the ledger, the contract, the moulds, the letter. Sit.",
              "VoiceId": "7e3f4b75fe00f4b5",
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "Who is holding your mouth shut?",
                "Next": "n_verger",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "We were hired about the plumbing. What do you want of us?",
                "Next": "n_choose",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "n_verger",
            "Line": {
              "Text": "A verger. He tends me the way a man tends a grave: tidily, so that nothing ever comes up. Four of you every nineteen years, and your wells run sweet. That is the whole of the arithmetic.",
              "VoiceId": "3431de2973d82a90",
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "And if we take his hand away?",
                "Next": "n_choose",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "n_choose",
            "Line": {
              "Text": "Below is the last station. Finish the pilgrimage and I open my eyes, and Dunmarrow learns what it stands on. Or burn the contract and I dream on, and your town keeps its souls. I will not argue either way.",
              "VoiceId": "8788be7206fc4857",
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "We finish it. Wake, and let the town take its chances.",
                "Next": null,
                "Effect": "Choose",
                "Flag": "wake_gorm",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Dream on. We burn the contract and leave you sleeping.",
                "Next": null,
                "Effect": "Choose",
                "Flag": "let_him_dream",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q_pilgrimage",
      "CastId": "cast_maud",
      "Persona": {
        "VoiceStyle": "an old woman speaking slowly for something far larger than herself; dry, kind, unhurried, never startled",
        "DefaultDelivery": "calm",
        "Voice": null,
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    }
  ],
  "Quests": [
    {
      "Id": "q_pilgrimage",
      "Template": "Decide",
      "Title": "The End of the Pilgrimage",
      "Objective": "Tell the sleeper whether to wake",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_maud",
      "Reward": {
        "Xp": 600,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Four papers and four graves say the same word. Choose it aloud, inspectors: my eyes open, or the contract burns and the dream goes deeper. Either is a kindness; neither is clean.",
          "VoiceId": "fbbb3587b502e4a6",
          "Delivery": "calm"
        },
        "Accept": {
          "Text": "Said, then. Carry it down. He will hear it before you reach him; he hears everything that happens in my throat.",
          "VoiceId": "601bef6eee925901",
          "Delivery": "calm"
        },
        "Decline": {
          "Text": "Then stand there a while. I have waited three hundred years; I can wait out a quiet spell from four plumbers.",
          "VoiceId": "52a14868f86671f1",
          "Delivery": "calm"
        },
        "Complete": {
          "Text": "Thank you for coming. Nobody has, before. They were sent, and that is a different verb.",
          "VoiceId": "30ff212b4e203785",
          "Delivery": "calm"
        },
        "Fail": {
          "Text": "No matter. The verse finishes itself eventually, with or without a mouth.",
          "VoiceId": "fdb725a819a6efb7",
          "Delivery": "weary"
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [],
  "Taunts": [],
  "EnemyTotal": 10
