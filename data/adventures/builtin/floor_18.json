  "Npcs": [
    {
      "Id": "captain_voss_ally",
      "Name": "Captain Voss",
      "Room": 2,
      "VoiceId": "Umbriel",
      "Script": {
        "Start": "offer",
        "Nodes": [
          {
            "Id": "offer",
            "Line": {
              "Text": "You\u0027re still breathing. Good. There\u0027s a knot of void-callers guarding the way down. Help me rip them apart, and I\u0027ll cut you in on the spoils.",
              "VoiceId": "e5a24e9ed17dd806"
            },
            "Choices": [
              {
                "Text": "What do you get out of this?",
                "Next": "catch",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "We\u0027ll handle it.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "On your own, Voss.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "It is done.",
                "Next": "done_voss_kill_stairs",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "catch",
            "Line": {
              "Text": "I\u0027ve got my eye on something in the vaults, but I can\u0027t get near it with those shrieking bastards on patrol. You clear the stairs, I\u0027ll do the rest.",
              "VoiceId": "48c2fa6d4007f12d"
            },
            "Choices": [
              {
                "Text": "Fine, we\u0027ll kill them.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "No deal. Find another fool.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "done_voss_kill_stairs",
            "Line": {
              "Text": "Not bad at all. Here\u0027s your cut. Don\u0027t spend it all in one place.",
              "VoiceId": "8bd941e8e06987a4"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "voss_kill_stairs",
      "CastId": null,
      "RequiresFlag": "shared_quest",
      "ForbidsFlag": null,
      "Betrayal": null
    },
    {
      "Id": "captain_voss_foe",
      "Name": "Captain Voss",
      "Room": 2,
      "VoiceId": "Umbriel",
      "Script": {
        "Start": "confront",
        "Nodes": [
          {
            "Id": "confront",
            "Line": {
              "Text": "Thought you\u0027d seen the last of me? This time, there\u0027s no negotiating. I\u0027m taking your haul and your heads.",
              "VoiceId": "dbc05238bcd472f4"
            },
            "Choices": [
              {
                "Text": "Then come and claim them.",
                "Next": null,
                "Effect": "Betray",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
