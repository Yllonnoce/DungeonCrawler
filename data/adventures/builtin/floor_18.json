  "Quests": [
    {
      "Id": "q_pilgrimage",
      "Template": "Decide",
      "Title": "What to Ask of Gorm",
      "Objective": "Tell Gorm how much to ask of him",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_maud",
      "Reward": {
        "Xp": 600,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Ask nothing of me, or ask for my strength. Either way, bring the water down.",
          "VoiceId": null,
          "Delivery": "calm"
        },
        "Accept": {
          "Text": "Said, then. Carry it down with you.",
          "VoiceId": null,
          "Delivery": "calm"
        },
        "Decline": {
          "Text": "Then sit a while. I have slept three hundred years; I can wait a little longer.",
          "VoiceId": null,
          "Delivery": "calm"
        },
        "Complete": {
          "Text": "Thank you for coming down to me.",
          "VoiceId": null,
          "Delivery": "calm"
        },
        "Fail": {
          "Text": "No matter. Bring the water down, and I will sleep either way.",
          "VoiceId": null,
          "Delivery": "weary"
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "RoomEnter",
      "Room": 0,
      "Line": {
        "Text": "When Maud looks up, it is not Maud looking. Gorm, the god under Dunmarrow, is close enough here to speak through her, and each word comes slowly.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Taunts": [
    {
      "Trigger": "Descend",
      "Objective": null,
      "Line": {
        "Text": "Your god is half awake, hirelings, and the dream is thin as paper. I can hear my master on the other side of it. You did that for him, and nobody paid you a bloody penny.",
        "VoiceId": null,
        "Delivery": null
      },
      "CleanLine": {
        "Text": "Your god is half awake, hirelings, and the dream is thin as paper. I can hear my master on the other side of it. You did that for him, and nobody paid you a penny.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": "wake_gorm",
      "ForbidsFlag": null,
      "FromStock": false
    },
    {
      "Trigger": "Descend",
      "Objective": null,
      "Line": {
        "Text": "You told your god to go back to sleep, hirelings. A god too bloody frightened to wake. My master is frightened of nothing, and he is still at the door.",
        "VoiceId": null,
        "Delivery": null
      },
      "CleanLine": {
