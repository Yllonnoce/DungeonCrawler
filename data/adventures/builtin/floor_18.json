  "Npcs": [
    {
      "Id": "npc_maud",
      "Name": "Maud Sorrel",
      "Room": 0,
      "VoiceId": "Gacrux",
      "Script": {
        "Start": "n_sit",
        "Nodes": [
          {
            "Id": "n_sit",
            "Line": {
              "Text": "I am Gorm; Maud has lent me her mouth. Forgive the shaking and the people hurt. I am starving and half awake, and my hunger will bring the mines down on Dunmarrow. Send the water down, and let me sleep.",
              "VoiceId": null,
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "What happens if you wake?",
                "Next": "n_wake",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Who did this to you?",
                "Next": "n_verger",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "What do you want from us?",
                "Next": "n_choose",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Not yet. We\u0027ll come back.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "n_wake",
            "Line": {
              "Text": "My dream is the door that keeps the Sleepless out. If I wake, the door opens, and Dunmarrow is the first thing the Sleepless finds. I would not mean it. It would happen all the same.",
              "VoiceId": null,
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "Who did this to you?",
                "Next": "n_verger",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "What do you want from us?",
                "Next": "n_choose",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "n_verger",
            "Line": {
              "Text": "My Verger prayed to me for forty years, and I was asleep and could not answer. The orc\u0027s master answered him instead. So the Verger opened the crypt door, and now he is below you, at a rite to wake me.",
              "VoiceId": null,
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "What happens if you wake?",
                "Next": "n_wake",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "What do you want from us?",
                "Next": "n_choose",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "n_choose",
            "Line": {
              "Text": "Ask nothing, and I sleep deep while you face the orc alone. Ask for my strength, and I strike at him, but I come nearer waking; if I wake, the Sleepless comes through and Dunmarrow dies. Which?",
              "VoiceId": null,
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "Sleep. We will finish it.",
                "Next": "n_dream",
                "Effect": "Choose",
                "Flag": "let_him_dream",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Lend us what strength you have.",
                "Next": "n_lend",
                "Effect": "Choose",
                "Flag": "wake_gorm",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "n_dream",
            "Line": {
              "Text": "He\u0027s gone back down, dear, deep and quiet. Good. I\u0027ll go on ahead to the shrine below and hold him there against the Verger\u0027s rite. You keep the Sleepless\u0027s kind off me.",
              "VoiceId": null,
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "n_lend",
            "Line": {
              "Text": "He heard you, dear. He\u0027ll reach for that orc from his sleep when you need it, but he\u0027s nearer waking now. I\u0027ll go ahead to the shrine below and hold him steady. Keep the Sleepless\u0027s kind off me.",
              "VoiceId": null,
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "q_pilgrimage",
