  "Npcs": [
    {
      "Id": "npc_lunette",
      "Name": "Lunette",
      "Room": 4,
      "VoiceId": "Aoede",
      "Script": {
        "Start": "start",
        "Nodes": [
          {
            "Id": "start",
            "Line": {
              "Text": "You\u0027ve returned! I\u0027ve found more fragments of the old bathhouse maps, but they\u0027re scattered in the crypt. Could you fetch them for me?",
              "VoiceId": "5d10a77097b71fcd"
            },
            "Choices": [
              {
                "Text": "We\u0027ll find them.",
                "Next": "accept",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Not interested.",
                "Next": "decline",
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "It is done.",
                "Next": "turnin",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "accept",
            "Line": {
              "Text": "Thank the stars. They should be in the old sanctum and the guard rooms... I think.",
              "VoiceId": "d09bd09a62adebe8"
            },
            "Choices": [
              {
                "Text": "We\u0027ll be back.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "decline",
            "Line": {
              "Text": "Suit yourself. I\u0027ll manage. The cartographer\u0027s life is solitary.",
              "VoiceId": "1fd1dd183cf0ddf9"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "turnin",
            "Line": {
              "Text": "Ah, you found them! Let me see... Hmm, these symbols, they look like bathhouses, yes?",
              "VoiceId": "3a18edc7dffd3d55"
            },
            "Choices": [
              {
                "Text": "Hand over the fragments.",
                "Next": "interpret",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "interpret",
            "Line": {
              "Text": "So... what do you make of them?",
              "VoiceId": "53879164a3c2d1ae"
            },
            "Choices": [
              {
                "Text": "These were quarantine zones, Lunette. Not baths.",
                "Next": "farewell",
                "Effect": "Choose",
                "Flag": "told_truth",
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Clearly baths. Big ones.",
                "Next": "farewell",
                "Effect": "Choose",
                "Flag": "lie_to_lunette",
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "farewell",
            "Line": {
              "Text": "I see... Thank you for your perspective.",
              "VoiceId": "d0fe1128e4c5bd64"
            },
            "Choices": [
              {
                "Text": "Goodbye.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "lunette_quest",
      "CastId": null,
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    }
  ],
  "Quests": [
    {
      "Id": "lunette_quest",
      "Template": "Investigate",
      "Title": "Lunette\u0027s Second Map",
      "Objective": "Find Lunette\u0027s scattered quarantine pages",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [
          4,
          6,
          8
        ],
        "ClueName": "torn quarantine pages"
      },
      "GiverNpc": "npc_lunette",
      "Reward": {
        "Xp": 150,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "I\u0027ve been piecing together more of the old bathhouse maps, but some pages have blown away. Find them, and we\u0027ll have the whole picture!",
          "VoiceId": null
        },
        "Accept": {
          "Text": "Marvelous! They were last seen near an old ruin, a guard post, and a dusty nest. Yes, dusty.",
          "VoiceId": null
        },
        "Decline": {
          "Text": "Ah, well. I\u0027ll draw what I can from memory.",
          "VoiceId": null
        },
        "Complete": {
          "Text": "She eagerly unfolds your finds, murmuring about ancient spa layouts.",
          "VoiceId": null
        },
        "Fail": {
          "Text": "Without those pages, my map remains incomplete. Perhaps another time.",
          "VoiceId": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "Enter",
      "Room": null,
      "Line": {
