  "Npcs": [
    {
      "Id": "captain_voss",
      "Name": "Captain Voss",
      "Room": 9,
      "VoiceId": "Umbriel",
      "Script": {
        "Start": "voss_start",
        "Nodes": [
          {
            "Id": "voss_start",
            "Line": {
              "Text": "Voss leans against a pillar, a crossbow hanging loosely in his grip. \u0027I\u0027ve seen the way you fight. Half your spoils, and I\u0027ll make sure you reach the forge without any more trouble. What do you say?\u0027",
              "VoiceId": "dff00682ff3100b5"
            },
            "Choices": [
              {
                "Text": "\u0022Fine. We\u0027ll split it.\u0022",
                "Next": "voss_share",
                "Effect": "Choose",
                "Flag": "shared_quest",
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "\u0022We don\u0027t share with scavengers.\u0022",
                "Next": "voss_driven",
                "Effect": "Choose",
                "Flag": "drove_off_voss",
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "voss_share",
            "Line": {
              "Text": "He grins, a glint of gold in his eye. \u0027Good. I\u0027ll be around. Don\u0027t die before we settle up.\u0027",
              "VoiceId": "ea60d64d40944d1a"
            },
            "Choices": [
              {
                "Text": "\u0022Let\u0027s move.\u0022",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "voss_driven",
            "Line": {
              "Text": "His grin vanishes. \u0027You\u0027ll regret that.\u0027 He backs into the shadows.",
              "VoiceId": "b5461ec6d835e953"
            },
            "Choices": [
              {
                "Text": "\u0022Better run.\u0022",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "rival_gambit",
      "CastId": null,
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    }
  ],
