      "Lines": {
        "Offer": {
          "Text": "The vestry watch won\u0027t stay dead. Clear them and the road\u0027s yours.",
          "VoiceId": "875f0a3557163cc5",
          "Delivery": null
        },
        "Accept": {
          "Text": "Good. Business first, silver after.",
          "VoiceId": "97ec3fbbd56590a8",
          "Delivery": null
        },
        "Decline": {
          "Text": "Suit yourselves. The Company\u0027s patient. I\u0027m less so.",
          "VoiceId": "b3fc9fb12047fac5",
          "Delivery": "sly"
        },
        "Complete": {
          "Text": "That\u0027s the road open. Keep going down, and bring what you find to me.",
          "VoiceId": "14216d5e46532fdc",
          "Delivery": null
        },
        "Fail": {
          "Text": "Well. That\u0027s a shame for the road.",
          "VoiceId": "35eb17269de806d1",
          "Delivery": "weary"
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
