  "Npcs": [
    {
      "Id": "npc_crane",
      "Name": "Alderman Hesketh Crane",
      "Room": 1,
      "VoiceId": "Umbriel",
      "Script": {
        "Start": "gate",
        "Nodes": [
          {
            "Id": "gate",
            "Line": {
              "Text": "Alderman Crane, for the council. That orc came up the shaft shouting that the mines are his master\u0027s now, and that he can\u0027t be killed for good. The drains need clearing, and I am not the man to do it.",
              "VoiceId": "1902c97929fb1a80",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What\u0027s gone wrong down there?",
                "Next": "bread",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "So what\u0027s the job?",
                "Next": "bread",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Your basket. Notices and all.",
                "Next": "done",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": {
              "Member": "Sable",
              "Line": {
                "Text": "He means us.",
                "VoiceId": "d8479177a1a5fac9",
                "Delivery": null
              }
            }
          },
          {
            "Id": "bread",
            "Line": {
              "Text": "Sour wells, shaking ground, and wardens who went down and never came up. Clear the traps and the dead so the drains can run. And fetch my basket from the first cellar; it has council notices in it. Unread, please.",
              "VoiceId": "2ead26e6d471952b",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll fetch your basket.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Fetch your own basket, alderman.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Your basket. Notices and all.",
                "Next": "done",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "done",
            "Line": {
              "Text": "You didn\u0027t read them? Don\u0027t answer; I\u0027d rather believe it. Council notices, nothing more, and the council thanks you in writing.",
              "VoiceId": "75cb18dff1e5f8ee",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Go back up, Crane. While the gate\u0027s open.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "q1_basket",
      "CastId": "cast_crane",
      "Persona": {
        "VoiceStyle": "a plump market-town alderman; bluster over panic, speaks in clauses, invoices and apologies",
        "DefaultDelivery": "cheerful",
        "Voice": "Umbriel",
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null,
      "Ritualist": false
    },
    {
      "Id": "npc_maud_1",
      "Name": "Maud Sorrel",
      "Room": 3,
      "VoiceId": "Gacrux",
      "Script": {
        "Start": "m1_step",
        "Nodes": [
          {
            "Id": "m1_step",
            "Line": {
              "Text": "Mind the step, dear, it\u0027s wet. Help me clear the grates; I\u0027m late on my rounds. The water has to go down. It always has to go down.",
              "VoiceId": "a9039cfe6e9c3893",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Who are you, mother?",
                "Next": "m1_who",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "You should go back up. It isn\u0027t safe.",
                "Next": "m1_back",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Mind how you go, mother.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "m1_who",
            "Line": {
              "Text": "Maud Sorrel, dear. Drain-warden, thirty-eight years. I was on my rounds, and then the water... well, never mind. Wet? I\u0027ve been wetter.",
              "VoiceId": "37bd739b5f31d3e8",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Thirty-eight years?",
                "Next": "m1_back",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": {
              "Member": "Wren",
              "Line": {
                "Text": "She\u0027s soaked through. Wrong.",
                "VoiceId": "dff78a21d0af0ab9",
                "Delivery": null
              }
            }
          },
          {
            "Id": "m1_back",
            "Line": {
              "Text": "Thirty-eight years, dear, and I\u0027ve never missed a round, so I\u0027m not going up now. The wells up top are sour; that\u0027s the grates, packed solid. The water has to go down.",
              "VoiceId": "06608282eb27c8f9",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Mind how you go, mother.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": null,
      "CastId": "cast_maud",
      "Persona": {
        "VoiceStyle": "an old workwoman soaked to the skin: unhurried, kind, faintly amused at her own state",
        "DefaultDelivery": "calm",
        "Voice": "Gacrux",
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null,
      "Ritualist": false
    }
  ],
  "Quests": [
    {
      "Id": "q1_basket",
      "Template": "Recover",
      "Title": "Council Property",
      "Objective": "Fetch the alderman\u0027s bread-basket, and the council notices in it, up from the first cellar.",
      "Params": {
        "TargetCollective": null,
        "ItemName": "the alderman\u0027s bread-basket",
        "ItemRoom": 7,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_crane",
      "Reward": {
        "Xp": 40,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "I took the council notices off the board at the mine head this morning and put them in my bread-basket. Then the orc came up the stair, I ran, and the basket stayed in the first cellar. Bring it back. Don\u0027t read them.",
          "VoiceId": "76e50067bb1896aa",
          "Delivery": null
        },
        "Accept": {
          "Text": "Good. Good. Don\u0027t eat the cloth.",
          "VoiceId": "6f387259a2d584ba",
          "Delivery": null
        },
        "Decline": {
          "Text": "Then it rots down there with the rest of the parish\u0027s goodwill. Suit yourselves.",
          "VoiceId": "4ccd4af6fd91de6a",
          "Delivery": null
        },
        "Complete": {
          "Text": "Every notice, and the cloth folded on top. Good. Nothing anyone needs to read. The council thanks you in writing.",
          "VoiceId": "be4a78060099d609",
          "Delivery": "weary"
        },
        "Fail": {
          "Text": "Keep it. I shall enter the basket on the loss ledger, under drainage.",
          "VoiceId": "61f9b6969b9673f1",
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "RoomEnter",
      "Room": 0,
      "Line": {
        "Text": "The orc at the gate is Morg Ashtusk, Herald of the Sleepless, an evil god. He has taken these mines for his master, and he means to keep you from the drains below.",
        "VoiceId": "8f9f5d09cf16b58a",
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Taunts": [
    {
      "Trigger": "Descend",
      "Objective": null,
      "Line": {
        "Text": "Down you come, hirelings. Kill me at the gate or not; my foundry pours another. These mines are my master\u0027s now, and your bloody god is going to wake.",
        "VoiceId": "032b7166707b6610",
        "Delivery": null
      },
