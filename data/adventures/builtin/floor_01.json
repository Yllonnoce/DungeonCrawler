  "Npcs": [
    {
      "Id": "npc_crane",
      "Name": "Alderman Hesketh Crane",
      "Room": 1,
      "VoiceId": "Umbriel",
      "Script": {
        "Start": "gate",
        "Nodes": [
          {
            "Id": "gate",
            "Line": {
              "Text": "Nobody said god. I said plumbing. Legally those are very different words, and the contract uses mine.",
              "VoiceId": "0712ef2049dc0183",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Then what is breathing down there?",
                "Next": "bread",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Show us the seal and stand aside.",
                "Next": "bread",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "It is done.",
                "Next": "bread",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "bread",
            "Line": {
              "Text": "Sour wells. Nineteen years of silt. That is all it has ever been. There is bread in the first cellar; I put it there myself.",
              "VoiceId": "392f73989857bf6b",
              "Delivery": "warm"
            },
            "Choices": [
              {
                "Text": "We\u0027ll bring your basket back.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Keep your crumbs, alderman.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Your basket. And the paper folded in it.",
                "Next": "done",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "A counterfoil. An old form. Every house in Dunmarrow has one in a drawer. Go down, inspectors; the council thanks you in writing.",
              "VoiceId": "a57442cfe88282be",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Go back up, Crane. While the gate\u0027s open.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q1_basket",
      "CastId": "cast_crane",
      "Persona": {
        "VoiceStyle": "a plump market-town alderman; bluster over panic, speaks in clauses, invoices and apologies",
        "DefaultDelivery": "cheerful",
        "Voice": "Umbriel",
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    }
  ],
  "Quests": [
    {
      "Id": "q1_basket",
      "Template": "Recover",
      "Title": "Council Property",
      "Objective": "Fetch the alderman\u0027s bread-basket up from the first cellar.",
      "Params": {
        "TargetCollective": null,
        "ItemName": "the alderman\u0027s bread-basket",
        "ItemRoom": 7,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_crane",
      "Reward": {
        "Xp": 40,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "There is bread in the first cellar. I put it there myself. Bring the basket up when it\u0027s empty; the basket is council property, and I account for everything.",
          "VoiceId": "d3e12ba68b2ea3bf",
          "Delivery": null
        },
        "Accept": {
          "Text": "Good. Good. Don\u0027t eat the cloth.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Then it rots down there with the rest of the parish\u0027s goodwill. Suit yourselves.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "...and the counterfoil folded in the bottom. That is nothing. An old form. Mind the step on your way down, there\u0027s good inspectors.",
          "VoiceId": "ba9907f5e58039f3",
          "Delivery": "weary"
        },
        "Fail": {
          "Text": "Keep it. I shall enter the basket on the loss ledger, under drainage.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "RoomEnter",
      "Room": 0,
      "Line": {
        "Text": "Coats on hooks, buttoned, numbered in the sexton\u0027s hand. The last four hung theirs here too; the tickets are still in the pockets.",
        "VoiceId": "db295055f3c8fb9d",
        "Delivery": null
      },
      "RequiresFlag": null,
