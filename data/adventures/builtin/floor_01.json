  "Npcs": [
    {
      "Id": "npc_hollis",
      "Name": "Hollis Penn",
      "Room": 6,
      "VoiceId": "Orus",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Brand! Sable! The whole lantern brigade. Hollis Penn, Company quartermaster, came down a day ahead to smooth the road. Small snag: the vestry watch won\u0027t stay dead. Clear them and the road\u0027s yours.",
              "VoiceId": "c3dac533e31aa679",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll clear the watch.",
                "Next": "accepted",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "You came down a day ahead. Alone?",
                "Next": "alone",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "The watch is dead.",
                "Next": "done",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Not our job, Hollis.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "alone",
            "Line": {
              "Text": "Alone, yes, more or less. The Company likes a man on the ground before the ground gets crowded. Don\u0027t fret about me. Fret about the two in the colonnade with no faces.",
              "VoiceId": "17c0d37144649b00",
              "Delivery": "sly"
            },
            "Choices": [
              {
                "Text": "We\u0027ll clear the watch.",
                "Next": "accepted",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Later.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Good lads. Good lasses. There\u0027s a box of tithe silver in the vault that\u0027ll want a key, and I\u0027ve a note of where the key is. After. Business first.",
              "VoiceId": "cb86395ac32e395d",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "That\u0027s the road open, then. Here, from the Company\u0027s purse, and my compliments. Keep going down. Whatever you find, I\u0027d take it straight to me. I\u0027ll be about.",
              "VoiceId": "741722bc30d04026",
              "Delivery": "warm"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "quest_watch",
      "CastId": "cast_hollis",
      "Persona": {
        "VoiceStyle": "a brisk, chummy company man, all smiles and quick sums, never quite looking at you",
        "DefaultDelivery": "cheerful",
        "Voice": "Puck",
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    }
