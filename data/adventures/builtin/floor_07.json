  "Npcs": [
    {
      "Id": "lunette",
      "Name": "Lunette",
      "Room": 7,
      "VoiceId": "Aoede",
      "Script": {
        "Start": "node_start",
        "Nodes": [
          {
            "Id": "node_start",
            "Line": {
              "Text": "Oh, you found me... I\u0027ve been lost down here for what feels like an age. There are bones, you see, bones etched with lichen\u2014maps to the surface, I\u0027m certain! Find them and bring them here, and I\u0027ll finally finish my char",
              "VoiceId": "63a85145d027b7bf"
            },
            "Choices": [
              {
                "Text": "We\u0027ll look for them.",
                "Next": "node_accept",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Not our problem.",
                "Next": "node_decline",
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "It is done.",
                "Next": "done_lunette_quest",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "node_accept",
            "Line": {
              "Text": "Three locations should have them. I\u0027ve marked them on your map. Hurry!",
              "VoiceId": "fdead90606787ed1"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "node_decline",
            "Line": {
              "Text": "Then I\u0027ll wait. The darkness never changes, anyway.",
              "VoiceId": "eb2d16f95fb5aaa3"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "done_lunette_quest",
            "Line": {
              "Text": "Lunette clutches the bones, and the lichen\u0027s glow seeps into her fingers. She holds them up, and her own hands are translucent. \u0027Ah,\u0027 she breathes. \u0027I see now. I never left the crypt at all.\u0027",
              "VoiceId": "62d442c1bae2eed8"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "lunette_quest",
      "CastId": null,
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    }
