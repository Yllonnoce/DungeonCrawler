  "Narration": [
    {
      "Trigger": "RoomEnter",
      "Room": 9,
      "Line": {
        "Text": "The orc\u0027s minions keep a rite at this altar to hurry the god awake. Beside it, Grisel Thorn, a warden, heaves at a seized pump and shouts to you: hold them off while she frees it, then help her find her crew.",
        "VoiceId": "40b5ac7fc4303e15",
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Taunts": [
    {
      "Trigger": "FloorEnter",
      "Objective": "ritual",
      "Line": {
        "Text": "My minions are holding a rite at the altar, hirelings, to hurry your god awake. That warden at the pump thinks a little bloody water will stop it.",
        "VoiceId": "b4a255148f7c3f1f",
        "Delivery": "calm"
      },
      "CleanLine": {
        "Text": "My minions are holding a rite at the altar, hirelings, to hurry your god awake. That warden at the pump thinks a little water will stop it.",
        "VoiceId": null,
        "Delivery": "calm"
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "FromStock": false
    },
    {
      "Trigger": "RitualistDown",
      "Objective": "ritual",
      "Line": {
        "Text": "Down goes the warden. Pick her up, hirelings, or the pump stays seized and my rite goes on.",
        "VoiceId": "99cac307b3c80297",
        "Delivery": null
      },
      "CleanLine": {
        "Text": "Down goes the warden. Pick her up, hirelings, or the pump stays seized and my rite goes on.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "FromStock": false
    },
    {
      "Trigger": "RitualDone",
      "Objective": "ritual",
      "Line": {
        "Text": "So the pump turns and my rite breaks. Enjoy it, hirelings. Your god is still hungry, and the drains below are still mine.",
        "VoiceId": "dbb189d74e7812f3",
        "Delivery": null
      },
      "CleanLine": {
        "Text": "So the pump turns and my rite breaks. Enjoy it, hirelings. Your god is still hungry, and the drains below are still mine.",
