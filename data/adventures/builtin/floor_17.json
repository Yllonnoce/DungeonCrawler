  "Quests": [
    {
      "Id": "q_crane_retainers",
      "Template": "Betrayal",
      "Title": "Crane\u0027s Retainers",
      "Objective": "Put down what the alderman left standing in his place.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_crane_17",
      "Reward": {
        "Xp": 600,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Don\u0027t look at me like that. The council voted. I only held the pen, and the pen was very heavy, and the wells ran clean for nineteen years.",
          "VoiceId": null,
          "Delivery": null
        },
        "Accept": {
          "Text": "Oh, don\u0027t. You\u0027ll only bleed on the Station, and they\u0027ve only just had it done.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Sensible. Walk on. I\u0027ll follow at my own pace, as I always have.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "The chain of office lies in the spoil with nobody inside it, and the gas comes up the gallery without hurrying.",
          "VoiceId": null,
          "Delivery": null
        },
        "Fail": {
          "Text": "The alderman is already climbing, and the carving will be done by candle, same as the last four times.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [],
