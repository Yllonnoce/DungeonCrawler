  "Npcs": [
    {
      "Id": "npc_crane_17",
      "Name": "Alderman Hesketh Crane",
      "Room": 9,
      "VoiceId": "Umbriel",
      "Script": {
        "Start": "n_meet",
        "Nodes": [
          {
            "Id": "n_meet",
            "Line": {
              "Text": "There you are. I came down to check the invoice. That is all this is. An invoice, and a gentleman seeing to it.",
              "VoiceId": "7f91bdd71a9d31e9",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Our names were on the memorial before we left.",
                "Next": "n_confess",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Go up, Crane. The gas is behind us.",
                "Next": "n_confess",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "n_confess",
            "Line": {
              "Text": "I signed it four times. Each time I thought, this is the last. Each time the wells cleared, and the children drank, and I carved the next four names by candle.",
              "VoiceId": "29933168bbac186d",
              "Delivery": "pleading"
            },
            "Choices": [
              {
                "Text": "Four. And we make the fourth four.",
                "Next": "n_turn",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "n_turn",
            "Line": {
              "Text": "He only asks for four, and you have been such a great deal of trouble, and I am so very tired of carving. Lie down. I\u0027ll have the chisel out by Michaelmas.",
              "VoiceId": "0a5c74209887a8cb",
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "Draw steel. He has already sold us.",
                "Next": null,
                "Effect": "Betray",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Walk away from him, down the gallery.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q_crane_retainers",
      "CastId": "cast_crane",
      "Persona": {
        "VoiceStyle": "a pompous market-town alderman, chain of office rattling, bluster thinning into a plea",
        "DefaultDelivery": "weary",
