      "Trigger": "RoomEnter",
      "Room": 9,
      "Line": {
        "Text": "In the Long Gallery the alderman hangs his whole weight on a sluice wheel, a shovel jammed through the spokes to hold it. The water drains off through the gate, and past it the gas is thinner.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
