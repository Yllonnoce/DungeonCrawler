  "Npcs": [
    {
      "Id": "npc_crane_17",
      "Name": "Alderman Hesketh Crane",
      "Room": 9,
      "VoiceId": "Umbriel",
      "Script": {
        "Start": "n_meet",
        "Nodes": [
          {
            "Id": "n_meet",
            "Line": {
              "Text": "There you are. I came down myself, shovel and all. Go on through while I hold this sluice open: the water\u0027s running off, and the gas is thinner past the gate.",
              "VoiceId": null,
              "Delivery": "weary"
            },
            "Choices": [
              {
                "Text": "Why come down yourself, Crane?",
                "Next": "n_confess",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "The Verger let the orc in. We read his letter.",
                "Next": "n_verger",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Did Grisel get her crew out?",
                "Next": "n_grisel",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": "grisel_forgiven",
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Hold it, then. We\u0027re going.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "n_confess",
            "Line": {
              "Text": "Because I owe it. We were glad of the Verger\u0027s order. Stopping the wardens\u0027 pay saved the council money, and I signed it. That\u0027s what I didn\u0027t tell you at the cistern.",
              "VoiceId": null,
              "Delivery": "weary"
            },
            "Choices": [
              {
                "Text": "The Verger let the orc in. We read his letter.",
                "Next": "n_verger",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Did Grisel get her crew out?",
                "Next": "n_grisel",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": "grisel_forgiven",
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Hold it, then. We\u0027re going.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "n_verger",
            "Line": {
              "Text": "Then he opened the door to that orc, and I stopped paying the wardens who\u0027d have found it. He did it for a god and I did it for the wages. I can\u0027t tell which of us I\u0027m angrier with.",
              "VoiceId": null,
              "Delivery": "weary"
            },
            "Choices": [
              {
                "Text": "Why come down yourself, Crane?",
                "Next": "n_confess",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Did Grisel get her crew out?",
                "Next": "n_grisel",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": "grisel_forgiven",
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Hold it, then. We\u0027re going.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "n_grisel",
            "Line": {
              "Text": "She did. Grisel Thorn and what\u0027s left of her crew are back on the upper drains, on full pay back to spring. I signed that too, and gladly.",
              "VoiceId": null,
              "Delivery": "weary"
            },
            "Choices": [
              {
                "Text": "Why come down yourself, Crane?",
                "Next": "n_confess",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Hold it, then. We\u0027re going.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
