  "Npcs": [
    {
      "Id": "npc_tobit_defect",
      "Name": "Deacon Tobit Hale",
      "Room": 8,
      "VoiceId": "Orus",
      "Script": {
        "Start": "tob_a",
        "Nodes": [
          {
            "Id": "tob_a",
            "Line": {
              "Text": "You told me the truth on the flagstones and I have not been able to stop hearing it. He writes the verses down, you know. I copied one out.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Which verse, deacon?",
                "Next": "tob_b",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Keep your copying. We have levers to pull.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "It is done.",
                "Next": "tob_c",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "tob_b",
            "Line": {
              "Text": "The Quench answers to a parity: which gates sleep while which wake. It is written in my psalter, and my psalter is in the font room, where I dropped it running.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll wade and fetch it.",
                "Next": "tob_c",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Fetch it yourself. You\u0027re the one who\u0027s dry.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "tob_c",
            "Line": {
              "Text": "Bring it back and I will read you the order aloud. After that I shall have to decide what I am, and I would rather do it with wet boots than none.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Here. Read.",
                "Next": null,
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Stay by the grate. We\u0027ll be back.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "quest_psalter",
      "CastId": "cast_tobit",
      "Persona": {
        "VoiceStyle": "a young deacon, over-polite and candle-lit, hopeful diction cracking around a new doubt",
        "DefaultDelivery": "warm",
        "Voice": null,
        "IsEmpty": false
      },
      "RequiresFlag": "told_tobit",
      "ForbidsFlag": null,
      "Betrayal": null
    },
    {
      "Id": "npc_tobit_choir",
      "Name": "Deacon Tobit Hale",
      "Room": 8,
      "VoiceId": "Orus",
      "Script": {
        "Start": "bet_a",
        "Nodes": [
          {
            "Id": "bet_a",
            "Line": {
              "Text": "The Verger sends his blessing and one kindness: the levers are all correct. Pull whichever you like. He would not lie to the congregation.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Then tell us which opens the stairs.",
                "Next": "bet_b",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "You\u0027ve been singing, deacon. We can hear it on you.",
                "Next": "bet_b",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "bet_b",
            "Line": {
              "Text": "I have been given a part. It is a small part, held very long, and it does not want words any more. He says I shall be better for it. He says I shall be quieter.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Step out of the water where we can see you.",
                "Next": null,
                "Effect": "Betray",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Keep your part. We\u0027ll find the gates without you.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "quest_tobit_choir",
      "CastId": "cast_tobit",
      "Persona": {
        "VoiceStyle": "a young deacon gone thin and formal, vowels stretched like held notes, pleased and far away",
        "DefaultDelivery": "calm",
        "Voice": null,
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": "told_tobit",
      "Betrayal": {
        "EnemyId": "enemy.forge_priest",
        "Count": 2
      }
    }
