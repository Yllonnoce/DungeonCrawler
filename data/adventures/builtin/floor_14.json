      "Trigger": "RoomEnter",
      "Room": 8,
      "Line": {
        "Text": "Church vestments float against the grate, black and gold, thrown off in the water: the Verger\u0027s. Beside them a young deacon stands soaked to the waist.",
        "VoiceId": "de007654aad121dc",
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Trigger": "QuestDone",
