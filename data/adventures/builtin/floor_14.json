      "Line": {
        "Text": "The orc\u0027s escort lies broken in the water, and the deacon is not among them. He ran on down to his master\u0027s summons.",
        "VoiceId": "3714fdad79c935d8",
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": "told_tobit"
    }
