  "Npcs": [
    {
      "Id": "npc_warden_hale",
      "Name": "Warden Hale",
      "Room": 3,
      "VoiceId": "Aoede",
      "Script": {
        "Start": "start",
        "Nodes": [
          {
            "Id": "start",
            "Line": {
              "Text": "You... you came. I prayed you would. I\u0027m the one who sealed these depths, who lured your Captain Voss with the promise of wealth. Now the Mourner feeds on my guilt, and I can\u0027t bear it any longer. End me, please. End me,",
              "VoiceId": "1fb8b2f6fac96792"
            },
            "Choices": [
              {
                "Text": "I will end your suffering.",
                "Next": "killed",
                "Effect": "Choose",
                "Flag": "killed_hale",
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "You deserve to live with your guilt.",
                "Next": "spared",
                "Effect": "Choose",
                "Flag": "spared_hale",
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "killed",
            "Line": {
              "Text": "Thank you. The silence... it\u0027s finally quiet. Take this, and end this place.",
              "VoiceId": "f361b98f144d8665"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "spared",
            "Line": {
              "Text": "You\u0027re worse than me. You\u0027ll let the Mourner feed forever. Go, then, and witness what your mercy breeds.",
              "VoiceId": "79fcae7843b5a467"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "quest_warden_wish",
