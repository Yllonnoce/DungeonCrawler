  "Npcs": [
    {
      "Id": "npc_tobit_defect",
      "Name": "Deacon Tobit Hale",
      "Room": 8,
      "VoiceId": "Orus",
      "Script": {
        "Start": "tob_a",
        "Nodes": [
          {
            "Id": "tob_a",
            "Line": {
              "Text": "I followed you down; I had to know. Those are my master\u0027s vestments in the water, thrown off like rags. Tell me plainly: did the Verger do this to the town?",
              "VoiceId": "3eeb5e61d846bc8c",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "His order kept the wardens out. That much is true.",
                "Next": "tob_b",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "We don\u0027t know yet, deacon.",
                "Next": "tob_b",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Go back up, deacon.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Your psalter, deacon.",
                "Next": "tob_d",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "tob_b",
            "Line": {
              "Text": "Then I won\u0027t accuse him without proof, and I mean to be thorough. I\u0027ve written down all I\u0027ve found in my psalter, and I dropped it in the font room when the cinders came. Will you fetch it?",
              "VoiceId": "6239b4512acc6250",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll fetch it.",
                "Next": "tob_c",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Fetch it yourself, deacon.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "tob_c",
            "Line": {
              "Text": "Thank you. It\u0027s by the font, where the wall broke open. The cinders came out of the breach and I ran. Mind them.",
              "VoiceId": "8bca491041e07d1d",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Here\u0027s your psalter.",
                "Next": "tob_d",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Stay by the grate. We\u0027ll be back.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "tob_d",
            "Line": {
              "Text": "My psalter. I\u0027ll write it all down: his vestments, in the water, thrown off. If he did this, it will be in his own hand somewhere, and I\u0027ll find it. I\u0027m thorough. I always am.",
              "VoiceId": "cd925e38c64a99d0",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Keep your head down, deacon.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "quest_psalter",
      "CastId": "cast_tobit",
      "Persona": {
        "VoiceStyle": "an eager young deacon, polite to a fault, delighted to have visitors at last",
        "DefaultDelivery": "warm",
        "Voice": "Puck",
        "IsEmpty": false
      },
      "RequiresFlag": "told_tobit",
      "ForbidsFlag": null,
      "Betrayal": null,
      "Ritualist": false
    },
    {
      "Id": "npc_tobit_choir",
      "Name": "Deacon Tobit Hale",
      "Room": 8,
      "VoiceId": "Orus",
      "Script": {
        "Start": "bet_a",
        "Nodes": [
          {
            "Id": "bet_a",
            "Line": {
              "Text": "You\u0027re here too! Those are my master\u0027s vestments in the water. He\u0027s alive, though; he\u0027s sent for me. The orc holds him prisoner, doesn\u0027t it? Tell me true.",
              "VoiceId": "144a18f1c97d8926",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We don\u0027t know, deacon. What did he send?",
                "Next": "bet_b",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "We can\u0027t say. Don\u0027t go.",
                "Next": "bet_b",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "bet_b",
            "Line": {
              "Text": "A note came to me at the church, in his own hand: \u0027Come below and help me with a rite that will save the town.\u0027 His escort waits for me by the grate. I\u0027m going to him.",
              "VoiceId": "48a0b72d226024a0",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "You\u0027re not going anywhere, deacon.",
                "Next": null,
                "Effect": "Betray",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Go to him, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "quest_tobit_choir",
      "CastId": "cast_tobit",
      "Persona": {
        "VoiceStyle": "an eager young deacon, polite to a fault, delighted to have visitors at last",
        "DefaultDelivery": "warm",
        "Voice": "Puck",
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": "told_tobit",
      "Betrayal": {
        "EnemyId": "enemy.forge_priest",
        "Count": 2,
        "Escort": true
      },
