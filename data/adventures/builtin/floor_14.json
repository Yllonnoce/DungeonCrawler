  "Quests": [
    {
      "Id": "quest_psalter",
      "Template": "Recover",
      "Title": "The Deacon\u0027s Psalter",
      "Objective": "Recover Tobit\u0027s psalter from the breached font room",
      "Params": {
        "TargetCollective": null,
        "ItemName": "Tobit\u0027s psalter",
        "ItemRoom": 3,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_tobit_defect",
      "Reward": {
        "Xp": 320,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Small black book, water-swollen, dropped by the font where the wall is broken. The parity is on the flyleaf in my own bad hand.",
          "VoiceId": null,
          "Delivery": null
        },
        "Accept": {
          "Text": "Thank you. Mind the cinders in there; they come out of the wall like wasps out of a loaf.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "No. Quite right. I lost it, I should drown for it. I only thought you preferred stairs to guessing.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "Second gate sleeps while the first wakes, then the fourth, then nothing. There. I have told you, and I am no longer his. Rather a relief, and rather late.",
          "VoiceId": null,
          "Delivery": null
        },
        "Fail": {
          "Text": "Then it stays in the water, and so does the order, and so, I suppose, do I.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": "told_tobit",
      "ForbidsFlag": null
    },
    {
      "Id": "quest_tobit_choir",
      "Template": "Betrayal",
      "Title": "A Part Held Very Long",
      "Objective": "Put down what wears the deacon\u0027s name",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": "npc_tobit_choir",
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_tobit_choir",
      "Reward": {
        "Xp": 300,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Stand where you are, please. The water carries the note. He asked me to keep you by the grate until the verse comes round again.",
          "VoiceId": null,
          "Delivery": null
        },
        "Accept": {
          "Text": "Oh. You wanted to see. Everybody wants to see, right up until.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "As you like. I shall wait. Waiting is most of the part.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "The singing stops in the flooded room. What is left in the deacon\u0027s coat was never going to make deacon.",
          "VoiceId": null,
          "Delivery": null
        },
        "Fail": {
          "Text": "Hush now. You are making the water ring.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": "told_tobit"
    }
  ],
