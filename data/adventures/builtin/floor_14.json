  "Npcs": [
    {
      "Id": "npc1",
      "Name": "Ilse the Smith",
      "Room": 3,
      "VoiceId": "Leda",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Hush. They do not know I am here. If you can help me, I can help you.",
              "VoiceId": "135087f32c34d991"
            },
            "Choices": [
              {
                "Text": "What happened to you?",
                "Next": "offer",
                "Effect": "None"
              },
              {
                "Text": "It is done.",
                "Next": "done",
                "Effect": "TurnIn"
              },
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "offer",
            "Line": {
              "Text": "They know I am here. The Ashen Foundry come in waves whenever I make a sound, and I cannot keep quiet forever. Stand with me through the next two and I will pay you from what I have hidden.",
              "VoiceId": "582f4992959d5f63"
            },
            "Choices": [
              {
                "Text": "I will do it.",
                "Next": "accepted",
                "Effect": "AcceptQuest"
              },
              {
                "Text": "Not now.",
                "Next": null,
                "Effect": "DeclineQuest"
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Then here they come. Do not let them reach me.",
              "VoiceId": "54c82af0e9db163d"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "It is quiet. Truly quiet. I had forgotten what that felt like. Take what I promised.",
              "VoiceId": "1b811a38678b7d0a"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          }
        ]
      },
      "QuestId": "quest1"
    }
  ],
  "Quests": [
    {
      "Id": "quest1",
      "Template": "HoldOut",
      "Title": "Hold the Line",
      "Objective": "Stand with Ilse the Smith against two waves of the Ashen Foundry.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
