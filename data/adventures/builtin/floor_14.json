      "Objective": "shiftingvault",
      "Line": {
        "Text": "Your deacon is down here too, hirelings, in my water, fishing out his master\u0027s robes. The stairs are behind my gates; pull the bloody levers and guess.",
        "VoiceId": "85a44509b34b7159",
        "Delivery": null
      },
      "CleanLine": {
