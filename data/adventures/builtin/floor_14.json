  "Quests": [
    {
      "Id": "quest_psalter",
      "Template": "Recover",
      "Title": "The Deacon\u0027s Psalter",
      "Objective": "Recover Tobit\u0027s psalter from the breached font room",
      "Params": {
        "TargetCollective": null,
        "ItemName": "Tobit\u0027s psalter",
        "ItemRoom": 3,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_tobit_defect",
      "Reward": {
        "Xp": 320,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Small black book, water-swollen, dropped by the font where the wall is broken. Everything I\u0027ve found is written in it, in my own bad hand.",
          "VoiceId": "f982915c9c1b22be",
          "Delivery": null
        },
        "Accept": {
          "Text": "Thank you. Mind the cinders in there; they come out of the wall like wasps out of a loaf.",
          "VoiceId": "42631f31c4e85d98",
          "Delivery": null
        },
        "Decline": {
          "Text": "No. Quite right. I dropped it; I should fetch it. I only hoped you\u0027d be quicker.",
          "VoiceId": "9c466dcd096420fa",
          "Delivery": null
        },
        "Complete": {
          "Text": "My psalter. I\u0027ll write the vestments in, and then I\u0027ll find the rest in his own hand.",
          "VoiceId": "13b03ab0f8856e3a",
          "Delivery": null
        },
        "Fail": {
          "Text": "Then it stays in the water, and I start again from memory. I have a good memory.",
          "VoiceId": "5336fd598875dd17",
          "Delivery": null
        }
      },
      "RequiresFlag": "told_tobit",
      "ForbidsFlag": null
    },
    {
      "Id": "quest_tobit_choir",
      "Template": "Betrayal",
      "Title": "The Deacon\u0027s Escort",
      "Objective": "Put down the escort the orc sent to fetch the deacon",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": "npc_tobit_choir",
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_tobit_choir",
      "Reward": {
        "Xp": 300,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "He\u0027s sent for me. A rite to save the town, in his own hand. I\u0027m going to him.",
          "VoiceId": "82f929fe3c7fdcd2",
          "Delivery": null
        },
        "Accept": {
          "Text": "I\u0027m going to him, and you won\u0027t stop me. Those are his escort; don\u0027t follow.",
          "VoiceId": "04e67551431740fe",
          "Delivery": null
        },
        "Decline": {
          "Text": "Thank you. Pray for me, if you pray.",
          "VoiceId": "78b14b9573aa4d94",
          "Delivery": null
        },
        "Complete": {
          "Text": "His escort lies in the water. The deacon is gone on down to his master.",
          "VoiceId": "65c0c3d0160a0631",
          "Delivery": null
        },
        "Fail": {
          "Text": "I\u0027m going to him. Don\u0027t follow.",
          "VoiceId": "816113c9dbaa15f5",
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": "told_tobit"
    }
  ],
  "Narration": [
