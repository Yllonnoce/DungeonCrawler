  "Quests": [
    {
      "Id": "q_ledger",
      "Template": "Investigate",
      "Title": "The Sexton\u0027s Ledger",
      "Objective": "Recover the scattered ledger pages from the drifts and bring them to Crane",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [
          4,
          6,
          1
        ],
        "ClueName": "a damp ledger page"
      },
      "GiverNpc": "npc_crane",
      "Reward": {
        "Xp": 140,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three pages, no more. One in the alms drift, one along the timbering, one up in the chantry. I would go myself, but the chain of office is heavy and I am, frankly, a coward.",
          "VoiceId": "44aee353fa0ccc2c",
          "Delivery": null
        },
        "Accept": {
          "Text": "Good. Good. I shall stand here and guard the heap, which is important work.",
          "VoiceId": "7adedb8a5c751b19",
          "Delivery": null
        },
        "Decline": {
          "Text": "Quite right. Paper is paper. It is only names.",
          "VoiceId": "f2e8721759459bbc",
          "Delivery": null
        },
        "Complete": {
          "Text": "Sixteen twelve. Four names. Sixteen thirty-one, four names. And so on, every nineteen years, and not one return date. The column says Rendered. I never asked what it meant.",
          "VoiceId": "aac3580d74ee1c60",
          "Delivery": "weary"
        },
        "Fail": {
          "Text": "Burnt, soaked, eaten. Just as well. A ledger is only a ledger if somebody reads it.",
          "VoiceId": "8b772ebb88d43e9c",
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "QuestDone",
      "Room": null,
      "Line": {
        "Text": "Crane holds the pages at arm\u0027s length, as a man holds something that has bitten him before.",
        "VoiceId": "498f4fc23aa7da49",
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Taunts": [
    {
      "Trigger": "FloorEnter",
      "Objective": "toxic",
      "Line": {
        "Text": "The chantry breathes out. It is only the damp, the gas and six hundred years of parish. Do not stand in the low ground, and do not bleed on the pages.",
        "VoiceId": "7ae2236a6c9afe67",
        "Delivery": null
      },
      "CleanLine": {
