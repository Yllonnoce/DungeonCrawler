  "Npcs": [
    {
      "Id": "npc_crane",
      "Name": "Alderman Hesketh Crane",
      "Room": 8,
      "VoiceId": "Umbriel",
      "Script": {
        "Start": "n1",
        "Nodes": [
          {
            "Id": "n1",
            "Line": {
              "Text": "Ah. You. I came down to check progress, that\u0027s all, and found the wardens\u0027 log with its last pages torn out and scattered through these drifts. Council property. I\u0027d like them back.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What\u0027s in the log?",
                "Next": "n2",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Keep your paper. The air is going green.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Your pages, alderman.",
                "Next": "n3",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "n2",
            "Line": {
              "Text": "Every clearing of the drains, every season, written down by the wardens for three hundred years. The last three pages are in the drifts. Bring them to me before anyone else reads them.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "I\u0027ll gather your pages.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Gather them yourself. Mind the gas.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "The pages are here, Alderman.",
                "Next": "n3",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "n3",
            "Line": {
              "Text": "Cleared every season for three hundred years. Then this spring: \u0027By the Verger\u0027s order, no one below.\u0027 The church stopped them. Not the council. Good. I mean, how dreadful.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Whatever you say, alderman.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "q_ledger",
      "CastId": "cast_crane",
      "Persona": {
        "VoiceStyle": "a plump market-town alderman; bluster over panic, speaks in clauses, invoices and apologies",
