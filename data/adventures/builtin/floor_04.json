  "Npcs": [
    {
      "Id": "npc_crane",
      "Name": "Alderman Hesketh Crane",
      "Room": 8,
      "VoiceId": "Umbriel",
      "Script": {
        "Start": "n1",
        "Nodes": [
          {
            "Id": "n1",
            "Line": {
              "Text": "Ah. You. I came down to check the invoice, that\u0027s all, and the sexton\u0027s book has gone and shed itself all over these drifts. Pages everywhere. Most irregular.",
              "VoiceId": "40208744a3b04433",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What is in the book, Alderman?",
                "Next": "n2",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Keep your paper. The air is going green.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "It is done.",
                "Next": "n2",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "n2",
            "Line": {
              "Text": "Plumbing inspections. Nineteen years apart, four names a time, and a column at the end that nobody ever filled in. Fetch the pages and I shall explain the column.",
              "VoiceId": "13082166d19a0111",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "I\u0027ll gather your pages.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Gather them yourself. Mind the gas.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "The pages are here, Alderman.",
                "Next": null,
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q_ledger",
      "CastId": "cast_crane",
      "Persona": {
        "VoiceStyle": "a plump market-town alderman, chain of office, blusters when cornered, apologises to furniture",
        "DefaultDelivery": "frantic",
