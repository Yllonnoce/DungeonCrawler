  "Quests": [
    {
      "Id": "q_ledger",
      "Template": "Investigate",
      "Title": "The Wardens\u0027 Log",
      "Objective": "Recover the scattered pages of the wardens\u0027 log from the drifts and bring them to Crane",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [
          7,
          6,
          1
        ],
        "ClueName": "a damp ledger page"
      },
      "GiverNpc": "npc_crane",
      "Reward": {
        "Xp": 140,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three pages, no more. One in the alms drift, one along the timbering, one up in the chantry. I would go myself, but the chain of office is heavy and I am, frankly, a coward.",
          "VoiceId": "44aee353fa0ccc2c",
          "Delivery": null
        },
        "Accept": {
          "Text": "Good. Good. I shall stand here and guard the heap, which is important work.",
          "VoiceId": "7adedb8a5c751b19",
          "Delivery": null
        },
        "Decline": {
          "Text": "Quite right. Paper is paper, and nobody reads the old ones.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "Three hundred years of clearings, and then this spring: \u0027By the Verger\u0027s order, no one below.\u0027 So it was the church. Not the council. What a relief. I mean, what a shame.",
          "VoiceId": null,
          "Delivery": null
        },
        "Fail": {
          "Text": "Burnt, soaked, eaten. Just as well. A ledger is only a ledger if somebody reads it.",
          "VoiceId": "8b772ebb88d43e9c",
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
