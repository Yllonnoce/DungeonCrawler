  "Npcs": [
    {
      "Id": "npc_maud_6",
      "Name": "Maud Sorrel",
      "Room": 6,
      "VoiceId": "Gacrux",
      "Script": {
        "Start": "m6_dry",
        "Nodes": [
          {
            "Id": "m6_dry",
            "Line": {
              "Text": "Soaked through and cold, dear, and no matter. Keep the water going down to Gorm. He is thirsty. Thirty-eight years I kept it moving, and now it stands here going sour.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Why is the water standing?",
                "Next": "m6_ahead",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Who else is down here?",
                "Next": "m6_tamsin",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "m6_ahead",
            "Line": {
              "Text": "The drains under us are choked, dear, packed solid like the grates up top, and not by accident. So the water backs up here and the god goes without. Clear them and it runs down to him again.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Who else is down here?",
                "Next": "m6_tamsin",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "m6_tamsin",
            "Line": {
              "Text": "Tamsin Rook, dear. Good miner. She came down after the wardens\u0027 tools, and her partner Jory went into this water ahead of her and hasn\u0027t come up. Help her look. The water won\u0027t give him back by itself.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
