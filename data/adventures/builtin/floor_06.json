  "Npcs": [
    {
      "Id": "npc1",
      "Name": "Corvin Shale",
      "Room": 2,
      "VoiceId": "Orus",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Another descent, another fool. Or perhaps a friend? Speak.",
              "VoiceId": "d344abc55229e431"
            },
            "Choices": [
              {
                "Text": "What happened to you?",
                "Next": "offer",
                "Effect": "None"
              },
              {
                "Text": "It is done.",
                "Next": "done",
                "Effect": "TurnIn"
              },
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "offer",
            "Line": {
              "Text": "They know I am here. The Crystal Brood come in waves whenever I make a sound, and I cannot keep quiet forever. Stand with me through the next two and I will pay you from what I have hidden.",
              "VoiceId": "aa3647efa94b6e13"
            },
            "Choices": [
              {
                "Text": "I will do it.",
                "Next": "accepted",
                "Effect": "AcceptQuest"
              },
              {
                "Text": "Not now.",
                "Next": null,
                "Effect": "DeclineQuest"
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Then here they come. Do not let them reach me.",
              "VoiceId": "2a90bca15ab5fb09"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "It is quiet. Truly quiet. I had forgotten what that felt like. Take what I promised.",
              "VoiceId": "2ac1bff358b6e4c8"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          }
        ]
      },
      "QuestId": "quest1"
    }
  ],
