  "Npcs": [
    {
      "Id": "npc_tarn",
      "Name": "Tarn",
      "Room": 7,
      "VoiceId": "Leda",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "You\u0027re the Company\u0027s. Good. Arrest me. Take me up. I\u0027m the turnkey and I\u0027ve kept his cages forty years and I want... I want to be the one in the cage. Please.",
              "VoiceId": "eb1094275264cf28",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Why would we take you?",
                "Next": "why",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "You\u0027re under arrest, Tarn.",
                "Next": "took",
                "Effect": "Choose",
                "Flag": "took_tarn",
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Keep your post. We\u0027ve a road to walk.",
                "Next": "left",
                "Effect": "Choose",
                "Flag": "left_tarn",
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Not now.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "why",
            "Line": {
              "Text": "Because I\u0027ve his key. The clerk\u0027s own. He counts every step and I count his. Take me and it\u0027s yours when you need it, and you will. Leave me and I stay his, and I do my job. I\u0027m good at my job.",
              "VoiceId": "c45d33a02feb233b",
              "Delivery": "pleading"
            },
            "Choices": [
              {
                "Text": "You\u0027re under arrest, Tarn.",
                "Next": "took",
                "Effect": "Choose",
                "Flag": "took_tarn",
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Keep your post.",
                "Next": "left",
                "Effect": "Choose",
                "Flag": "left_tarn",
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "took",
            "Line": {
              "Text": "Arrested. Ha. Forty years. I\u0027ll follow when I can and I\u0027ll keep the key dry. He\u0027ll shout about this. He shouts about everything.",
              "VoiceId": "4633443a6668b7d8",
              "Delivery": "warm"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "left",
            "Line": {
              "Text": "Aye. Thought so. Nobody takes the turnkey. Mind the cages below, then. I\u0027ll be locking them.",
              "VoiceId": "08c0a97548eda348",
              "Delivery": "angry"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "quest_tarn",
      "CastId": "cast_tarn",
