  "Boss": {
    "Name": "Morg Ashtusk",
    "SignatureOverride": "Volley",
    "IntroLine": {
      "Text": "Killed me at the gate, didn\u0027t you? I came back bigger. Your Verger is still upstairs on his knees, waiting for his reward. Priests. Turn that sluice wheel if you can reach it, hirelings.",
      "VoiceId": null,
      "Delivery": null
    },
    "DeathLine": {
      "Text": "Turn your wheel, then. My master will send another. Your god has to sleep for ever, hirelings. My master only has to wait.",
      "VoiceId": null,
      "Delivery": null
    },
    "HalfLine": {
      "Text": "Is this what the town paid for? Your god is hiding in his sleep, hirelings, and you are only day labour. I can do this all night.",
      "VoiceId": null,
      "Delivery": null
    },
    "AltDeathFlag": "wake_gorm",
    "AltHalfLine": {
      "Text": "That was your god. He reached up out of his sleep and struck me. Good. Every blow he lands wakes him further, and my master is right behind the door.",
      "VoiceId": null,
      "Delivery": null
    },
    "AltDeathLine": {
      "Text": "Your god struck me down from his sleep. Ha. It cost him, hirelings: he\u0027s nearly awake, and my master is almost through. Listen at the door.",
      "VoiceId": null,
      "Delivery": null
    }
  },
