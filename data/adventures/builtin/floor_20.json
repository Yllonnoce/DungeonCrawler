  "Npcs": [
    {
      "Id": "npc1",
      "Name": "The Pale Pilgrim",
      "Room": 11,
      "VoiceId": "Aoede",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Another descent, another fool. Or perhaps a friend? Speak.",
              "VoiceId": "3009a99ab25aa77f"
            },
            "Choices": [
              {
                "Text": "What happened to you?",
                "Next": "offer",
                "Effect": "None"
              },
              {
                "Text": "It is done.",
                "Next": "done",
                "Effect": "TurnIn"
              },
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "offer",
            "Line": {
              "Text": "I cannot go on alone; every corridor is watched. Take me as far as the stairs down and I will give you everything I carried out of the levels above.",
              "VoiceId": "60fd0677b067c1b1"
            },
            "Choices": [
              {
                "Text": "I will do it.",
                "Next": "accepted",
                "Effect": "AcceptQuest"
              },
              {
                "Text": "Not now.",
                "Next": null,
                "Effect": "DeclineQuest"
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "I will stay close. Please, do not leave me behind.",
              "VoiceId": "a03efd62b8080cf0"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "The stairs. I can manage from here. Thank you, stranger. Take this.",
              "VoiceId": "147681b6b0c5eb25"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          }
        ]
      },
      "QuestId": "quest1"
    }
  ],
