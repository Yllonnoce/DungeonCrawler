      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Trigger": "BossSeen",
      "Room": null,
      "Line": {
        "Text": "The Mourner\u0027s mouthpiece regards you with the hollow of a memory. It speaks without sound, but you feel the words in your chest.",
