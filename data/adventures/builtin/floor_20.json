  "Boss": {
    "Name": "The Verger",
    "SignatureOverride": "Volley",
    "IntroLine": {
      "Text": "Fourth Station. You have come a long way to lie down. Kneel; it is the same thing, only sooner.",
      "VoiceId": "80364500538c56b2",
      "Delivery": "calm"
    },
    "DeathLine": {
      "Text": "Hush. Hush. He\u0027s still... hush.",
      "VoiceId": "37a14d45489de59a",
      "Delivery": "whisper"
    },
    "HalfLine": {
      "Text": "You would keep Him asleep and kill me? Then one of you is the new Verger. I do not make the rules; I only wrote them down.",
      "VoiceId": "d1cfa9a93481008c",
      "Delivery": "calm"
    },
    "AltDeathFlag": "wake_gorm",
    "AltDeathLine": {
      "Text": "...He is saying something. He is saying thank you. Three hundred years, and that is what He...",
      "VoiceId": "2736272b311ed58f",
      "Delivery": "whisper"
    },
    "AltHalfLine": {
      "Text": "He is turning over. Do you know what a town looks like from underneath? You will.",
      "VoiceId": "575724869af88532",
      "Delivery": "calm"
    }
  },
