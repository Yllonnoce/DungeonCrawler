  "Narration": [
    {
      "Trigger": "BossSeen",
      "Room": null,
      "Line": {
        "Text": "Morg Ashtusk stands over the last great drain, not the orc body you killed at the gate but what the foundry was building him into: his true form. Kill him and turn the sluice wheel, or the mines come down on Dunmarrow.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Trigger": "BossDead",
      "Room": null,
      "Line": {
        "Text": "You turn the sluice wheel, and the last great drain runs. The water pours down to the god, and he drinks and slowly sinks back from waking. The dream holds; it is thin, but the door stays shut.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": "wake_gorm",
      "ForbidsFlag": null
    },
    {
      "Trigger": "BossDead",
      "Room": null,
      "Line": {
        "Text": "You turn the sluice wheel, and the last great drain runs. The water pours down to the god, and he drinks without ever stirring. The dream holds whole, and the door to the Sleepless stays shut.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": "wake_gorm"
    },
    {
      "Trigger": "BossDead",
      "Room": null,
      "Line": {
        "Text": "Far above you the ground goes still, and the wells of Dunmarrow run sweet. The mines will stand. One floor up the Verger kneels on, and nothing answers him. The job is done, and the town lives.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
