  "Narration": [
    {
      "Trigger": "BossDead",
      "Room": null,
      "Line": {
        "Text": "Far above, Dunmarrow lurches on His chest and the wells run clear and cold. The halls below are Gorm\u0027s waking thoughts now, and Maud walks them beside you, awake at last.",
        "VoiceId": "7c45722abefd86a4",
        "Delivery": null
      },
      "RequiresFlag": "wake_gorm",
      "ForbidsFlag": null
    },
    {
      "Trigger": "BossDead",
      "Room": null,
      "Line": {
        "Text": "The dream goes on. The Forge casts, and so do you. The halls below are only the dream deepening, and a long way down one of them somebody is still carrying a candle.",
        "VoiceId": "eeafe8cc858b55d6",
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": "wake_gorm"
    }
  ],
