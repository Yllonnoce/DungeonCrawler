      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Trigger": "BossDead",
      "Room": null,
      "Line": {
        "Text": "The Herald shatters into flecks of darkness. For a moment, the weight lifts\u2014then settles deeper, as if the stone itself is mourning.",
