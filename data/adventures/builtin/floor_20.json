  "Boss": {
    "Name": "Abyss Herald, Mouth of the Mourner",
    "SignatureOverride": "Summon",
    "IntroLine": {
      "Text": "A shape of congealed sorrow rises from the black pool at the room\u0027s centre. It has no face, only a voice that sounds like your own regrets.",
