  "Quests": [
    {
      "Id": "q_tobit_truth",
      "Template": "Decide",
      "Title": "What to Tell the Deacon",
      "Objective": "Tell Deacon Hale the god is starving and no help is coming, or let him keep praying.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_tobit",
      "Reward": {
        "Xp": 120,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "You\u0027ve seen more of these crypts than I have lately. Tell me plainly how it is. I am told I am a good listener.",
          "VoiceId": null,
          "Delivery": null
        },
        "Accept": {
          "Text": "Say it plainly. I would rather be wrong out loud than obedient in a whisper.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "As you wish. The candle will keep until you change your mind. It keeps very well.",
          "VoiceId": "e2113c1c204ac999",
          "Delivery": null
        },
        "Complete": {
          "Text": "Thank you for telling me how it is. I know what I have to do now.",
          "VoiceId": null,
          "Delivery": null
        },
        "Fail": {
          "Text": "Go down, then. I\u0027ll keep praying. Somebody has to.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [],
  "Taunts": [
    {
      "Trigger": "FloorEnter",
      "Objective": null,
      "Line": {
