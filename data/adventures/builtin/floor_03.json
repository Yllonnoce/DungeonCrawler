  "Npcs": [
    {
      "Id": "npc_tobit",
      "Name": "Deacon Tobit Hale",
      "Room": 7,
      "VoiceId": "Orus",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Pray with me, would you? The wells are sour and the ground shakes, but if we ask him properly, Gorm will save the town. He always has.",
              "VoiceId": null,
              "Delivery": "warm"
            },
            "Choices": [
              {
                "Text": "You\u0027re down here alone?",
                "Next": "ask",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Talk, deacon. We\u0027re listening.",
                "Next": "ask",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": {
              "Member": "Brand",
              "Line": {
                "Text": "No promises, deacon.",
                "VoiceId": "fee26d2b57352991",
                "Delivery": null
              }
            }
          },
          {
            "Id": "ask",
            "Line": {
              "Text": "Quite alone. My master the Verger went below in spring to pray for the town, and I keep the church till he\u0027s back. Tell me true: does Gorm hear us down there?",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Nobody\u0027s coming, deacon. Your god is starving. That\u0027s why we were hired.",
                "Next": "end",
                "Effect": "Choose",
                "Flag": "told_tobit",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "He hears you. Keep praying.",
                "Next": "end_kept",
                "Effect": "Choose",
                "Flag": "kept_his_saint",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": {
              "Member": "Ilex",
              "Line": {
                "Text": "Theologically, deacon, \u0027hears\u0027 and \u0027answers\u0027 are different words.",
                "VoiceId": null,
                "Delivery": null
              }
            }
          },
          {
            "Id": "end",
            "Line": {
              "Text": "Starving. And I\u0027ve been asking him to feed us. If the water isn\u0027t reaching him, I\u0027ll find out why; I\u0027m thorough, I always am. Mind the walls past here. Some are new, and they crush.",
              "VoiceId": null,
              "Delivery": "whisper"
            },
            "Choices": [
              {
                "Text": "Keep your head down, deacon.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "end_kept",
            "Line": {
              "Text": "Thank you. I knew he heard. I\u0027ll keep the candle lit until my master comes back up. Mind the walls past here; some of them are new, and they crush.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Keep your head down, deacon.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "q_tobit_truth",
      "CastId": "cast_tobit",
      "Persona": {
        "VoiceStyle": "an eager young deacon, polite to a fault, delighted to have visitors at last",
