  "Npcs": [
    {
      "Id": "npc_tobit",
      "Name": "Deacon Tobit Hale",
      "Room": 7,
      "VoiceId": "Orus",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Welcome to the First Station. The Verger sends his regrets, and asks that you not bleed on the flagstones; they were only just done.",
              "VoiceId": "4659fe519f848155",
              "Delivery": "warm"
            },
            "Choices": [
              {
                "Text": "Regrets for what, exactly?",
                "Next": "ask",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "We\u0027re here about the plumbing, deacon.",
                "Next": "ask",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "ask",
            "Line": {
              "Text": "Pilgrims come down the Gullet every nineteen years. He prepares the Stations himself. You are expected, and that is a comfort, is it not?",
              "VoiceId": "36e0b5664fc79710",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Nobody down here is expecting anything good. The council hired us to clear a drain.",
                "Next": "end",
                "Effect": "Choose",
                "Flag": "told_tobit",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "A great comfort. Say nothing more about it.",
                "Next": "end",
                "Effect": "Choose",
                "Flag": "kept_his_saint",
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "end",
            "Line": {
              "Text": "Then go gently. The chapel past the chancel has a press in the walls, and it does not care whose bones it is given.",
              "VoiceId": "134041eac2d23e33",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Mind the flagstones, deacon.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q_tobit_truth",
      "CastId": "cast_tobit",
      "Persona": {
        "VoiceStyle": "a young deacon, courteous and bright, polishing fear with liturgy; eager to be useful",
        "DefaultDelivery": "warm",
        "Voice": null,
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    }
  ],
  "Quests": [
    {
      "Id": "q_tobit_truth",
      "Template": "Decide",
      "Title": "Plumbers, Not Pilgrims",
      "Objective": "Tell Deacon Hale what the contract actually says, or let him keep his saint.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_tobit",
      "Reward": {
        "Xp": 120,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "You have the look of people with a paper in their coat. Read it to me, if you like. I am told I am a good listener.",
          "VoiceId": "d873c4806ed00bb7",
          "Delivery": null
        },
        "Accept": {
          "Text": "Yes. Say it plainly. He never says anything plainly, and I have stopped being able to tell why.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "As you wish. The candle will keep until you change your mind. It keeps very well.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "Plumbing. Four of you, every nineteen years, for the plumbing. I shall have to think about that somewhere with fewer bones in it.",
          "VoiceId": "faa24af1197ce42a",
          "Delivery": null
        },
        "Fail": {
          "Text": "Go down, then. He is waiting at the fourth, and he is very patient with me.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
