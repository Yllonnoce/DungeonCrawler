        },
        "Accept": {
          "Text": "He knows it\u0027s gone before it\u0027s gone.",
          "VoiceId": "00690bf8374e72c3",
          "Delivery": null
        },
        "Decline": {
          "Text": "Then I\u0027ll go myself. Slowly.",
          "VoiceId": "1ac22af94950ccb1",
