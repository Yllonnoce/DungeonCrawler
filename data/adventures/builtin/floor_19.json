  "Quests": [
    {
      "Id": "q_last_verse",
      "Template": "HoldOut",
      "Title": "The Last Verse",
      "Objective": "Hold the three galleries while Maud Sorrel finishes the verse.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": 3,
        "WaveCollective": "co_antiphon",
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_maud",
      "Reward": {
        "Xp": 760,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three galleries, three mouths, one old woman with the words. Keep them off me for the length of a hymn and this is done with.",
          "VoiceId": null,
          "Delivery": null
        },
        "Accept": {
          "Text": "Good. Do not listen too closely; the tune gets into people.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Then I shall wait here and hum it, and we shall all be very old before anything changes.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "There. Three hundred years of the same line, and someone finally sang the next one.",
          "VoiceId": null,
          "Delivery": null
        },
        "Fail": {
          "Text": "The verse is dropped. Pick me up; the Choir will start again from the top, and so, I am afraid, must we.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [],
  "Taunts": [
    {
      "Trigger": "RitualStart",
      "Objective": "ritual",
      "Line": {
        "Text": "The Waking? In my church? Put the bloody woman down and let Himself sleep, you half-witted congregation.",
