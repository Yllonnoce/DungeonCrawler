  "Npcs": [
    {
      "Id": "npc_tarn2",
      "Name": "Tarn",
      "Room": 6,
      "VoiceId": "Leda",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "You took me. You did take me. I kept the key dry, like I said. It\u0027s in his strongbox, the far one, he made me put it back but I know the lock. Fetch it and the Sexton\u0027s door is yours.",
              "VoiceId": "a63170e834fa7630",
              "Delivery": "warm"
            },
            "Choices": [
              {
                "Text": "We\u0027ll fetch the key.",
                "Next": "accepted",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "We have the clerk\u0027s key.",
                "Next": "done",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "We\u0027ll manage without.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Good. He\u0027s shouting already, can you hear him? He knows it\u0027s gone before it\u0027s gone. Forty years I listened to that.",
              "VoiceId": "905d1e57cbb600be",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "That\u0027s it. His key. Give it here... no. No, you keep it. You\u0027re the one arresting people now. Go and arrest him.",
              "VoiceId": "35adb3dda7aa6e32",
              "Delivery": "warm"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
