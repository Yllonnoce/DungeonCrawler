      },
      "Lines": {
        "Offer": {
          "Text": "They know I am here. The Void-Touched Host come in waves whenever I make a sound, and I cannot keep quiet forever. Stand with me through the next two and I will pay you from what I have hidden.",
          "VoiceId": "a873ebbe202a3af9"
        },
        "Accept": {
          "Text": "Then here they come. Do not let them reach me.",
          "VoiceId": "f3fdde1479168b15"
        },
        "Decline": {
          "Text": "Then leave me. Others will come, or they will not.",
          "VoiceId": "f15eeed9a2164490"
        },
        "Complete": {
          "Text": "It is quiet. Truly quiet. I had forgotten what that felt like. Take what I promised.",
          "VoiceId": "2d54b9bf0167a0d3"
        },
        "Fail": {
          "Text": "You left me. I will not forget that.",
