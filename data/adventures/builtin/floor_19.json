  "Narration": [
    {
      "Trigger": "Enter",
      "Room": null,
      "Line": {
        "Text": "Tarn never left his post. The clerk saw to that. Whatever holds the turnkey\u0027s post now holds it in his shape.",
        "VoiceId": "17244eec25853999",
        "Delivery": null
      },
      "RequiresFlag": "left_tarn",
      "ForbidsFlag": null
    },
    {
      "Trigger": "Enter",
      "Room": null,
      "Line": {
        "Text": "A shape by the ruined post lifts a hand: Tarn, the turnkey you arrested, forty years late and here before you.",
