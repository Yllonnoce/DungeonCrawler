  "Npcs": [
    {
      "Id": "npc_maud",
      "Name": "Maud Sorrel",
      "Room": 2,
      "VoiceId": "Gacrux",
      "Script": {
        "Start": "m_open",
        "Nodes": [
          {
            "Id": "m_open",
            "Line": {
              "Text": "There you are, dears. I\u0027ll sit at the altar and hold him asleep against the Verger\u0027s rite. You keep the Sleepless\u0027s kind off me while I do.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll hold them off, Maud.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Why does he need holding?",
                "Next": "m_which",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Not yet, Maud.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "It\u0027s done, Maud.",
                "Next": "m_done",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "m_which",
            "Line": {
              "Text": "The Verger is praying him awake, dear, and the orc\u0027s kind are helping. I can keep him asleep if nobody pulls me off the stone.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We asked for his strength. Hold him anyway.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": "wake_gorm",
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "We let him sleep. Keep him there.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": "wake_gorm",
                "NextIfRefused": null
              },
              {
                "Text": "Rest a moment, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "m_done",
            "Line": {
              "Text": "He\u0027s settled, dear. The Verger\u0027s rite has nothing left to pull on. Go on down to the last drain; he\u0027s thirsty.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Then we go down.",
                "Next": null,
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "q_last_verse",
      "CastId": "cast_maud",
      "Persona": {
        "VoiceStyle": "an old workwoman soaked to the skin: unhurried, kind, faintly amused at her own state",
        "DefaultDelivery": "calm",
        "Voice": "Gacrux",
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null,
      "Ritualist": true
    },
    {
      "Id": "npc_quill",
      "Name": "Absalom Quill",
      "Room": 7,
      "VoiceId": "Sadaltager",
      "Script": {
        "Start": "v1",
        "Nodes": [
          {
            "Id": "v1",
            "Line": {
              "Text": "Do keep your voices down; this is a rite. Forty years I swept Gorm\u0027s church, and he never once answered me. Something else has. Stand aside and let him wake.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "You let the orc in.",
                "Next": "v_door",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Tobit found your letter.",
                "Next": "v_letter_t",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": "told_tobit",
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "We read your letter.",
                "Next": "v_letter",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": "told_tobit",
                "NextIfRefused": null
              },
              {
                "Text": "Let the deacon go.",
                "Next": "v_tobit",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": "told_tobit",
                "NextIfRefused": null
              },
              {
                "Text": "Kneel there, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "v_door",
            "Line": {
              "Text": "I opened a door; I did not walk through it. My guest below promised that the god who comes through will reward the man who opened it. Gorm never rewarded anyone for anything.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "If Gorm wakes, the town dies.",
                "Next": "v_town",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Give back the church\u0027s ewer.",
                "Next": "v_ewer",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Kneel there, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "v_town",
            "Line": {
              "Text": "You will not frighten me with Dunmarrow. I have swept up after that town for forty years, and the god who comes after will find me standing in it, answered at last.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Gorm lent us his strength.",
                "Next": "v_wake",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": "wake_gorm",
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Gorm is going back to sleep.",
                "Next": "v_sleep",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": "wake_gorm",
                "NextIfRefused": null
              },
              {
                "Text": "Kneel there, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "v_wake",
            "Line": {
              "Text": "Did he? Then he is nearer waking than my rite could bring him, and you have done my work for me. Thank you. I shall mention you to the god who comes after.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Give back the church\u0027s ewer.",
                "Next": "v_ewer",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Kneel there, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "v_sleep",
            "Line": {
              "Text": "He will sleep while that drowned warden holds him, and not a moment longer. Maud Sorrel kept his drains. I kept the church\u0027s crypt door, and I opened it.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Give back the church\u0027s ewer.",
                "Next": "v_ewer",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Kneel there, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "v_letter",
            "Line": {
              "Text": "Read aloud, I expect, in my own church\u0027s halls. \u0027The way will be open by midwinter.\u0027 Yes, I wrote it, and I would write it again. I only ask that you stop reading my letters to strangers.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "You let the orc in.",
                "Next": "v_door",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Kneel there, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "v_letter_t",
            "Line": {
              "Text": "Tobit. Of course. I taught him to be thorough, and he was. \u0027The way will be open by midwinter.\u0027 I wrote it, and I would write it again. I only wish he had not read it aloud.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "You let the orc in.",
                "Next": "v_door",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Kneel there, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "v_tobit",
            "Line": {
              "Text": "I sent for Tobit and he came, as a good deacon should. He is my deacon. I do not let go of what is mine, and nor, I find, does the rite.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "You let the orc in.",
                "Next": "v_door",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Kneel there, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "v_ewer",
            "Line": {
              "Text": "That ewer blessed the drains every spring for three hundred years. Tonight it pours for the god who comes after. Sister Ione may have it back when the new god has come.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "You let the orc in.",
                "Next": "v_door",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Kneel there, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
