  "Npcs": [
    {
      "Id": "npc1",
      "Name": "Nyx",
      "Room": 1,
      "VoiceId": "Aoede",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Hush. They do not know I am here. If you can help me, I can help you.",
              "VoiceId": "fb3fc1aa4239c86c"
            },
            "Choices": [
              {
                "Text": "What happened to you?",
                "Next": "offer",
                "Effect": "None"
              },
              {
                "Text": "It is done.",
                "Next": "done",
                "Effect": "TurnIn"
              },
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "offer",
            "Line": {
              "Text": "They know I am here. The Void-Touched Host come in waves whenever I make a sound, and I cannot keep quiet forever. Stand with me through the next two and I will pay you from what I have hidden.",
              "VoiceId": "a873ebbe202a3af9"
            },
            "Choices": [
              {
                "Text": "I will do it.",
                "Next": "accepted",
                "Effect": "AcceptQuest"
              },
              {
                "Text": "Not now.",
                "Next": null,
                "Effect": "DeclineQuest"
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Then here they come. Do not let them reach me.",
              "VoiceId": "f3fdde1479168b15"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "It is quiet. Truly quiet. I had forgotten what that felt like. Take what I promised.",
              "VoiceId": "2d54b9bf0167a0d3"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          }
        ]
      },
      "QuestId": "quest1"
    }
  ],
  "Quests": [
    {
      "Id": "quest1",
      "Template": "HoldOut",
      "Title": "Hold the Line",
      "Objective": "Stand with Nyx against two waves of the Void-Touched Host.",
      "Params": {
        "TargetCollective": null,
