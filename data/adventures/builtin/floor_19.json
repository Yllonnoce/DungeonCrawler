  "Npcs": [
    {
      "Id": "npc_maud",
      "Name": "Maud Sorrel",
      "Room": 2,
      "VoiceId": "Despina",
      "Script": {
        "Start": "m_open",
        "Nodes": [
          {
            "Id": "m_open",
            "Line": {
              "Text": "I have carried this verse since the lychgate and I am tired of the weight of it. Stand in the galleries. The Choir will come for the parts I cannot sing.",
              "VoiceId": "da78b9476a1c1b55",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Sing. We\u0027ll hold the three mouths.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "What ends when the verse ends?",
                "Next": "m_which",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Keep your mouth shut and walk down with us.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "It is done.",
                "Next": "m_done",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "m_which",
            "Line": {
              "Text": "Something ends either way, dear. Mine, or His three hundred years of being tucked in. Say which you chose above, and I will sing that one.",
              "VoiceId": "b1dc9088bece3132",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "The Waking. Sing Him up.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": "wake_gorm",
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "The Unbinding. Let Him lie.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": "wake_gorm",
                "NextIfRefused": null
              },
              {
                "Text": "Nothing yet. Rest a moment.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "m_done",
            "Line": {
              "Text": "Finished. The tiles are warm; they were never tiles. The stair below remembers it is a throat, and it is opening.",
              "VoiceId": "8e5bf5898dbf30a5",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Then we go down.",
                "Next": null,
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
