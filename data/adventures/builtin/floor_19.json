  "Quests": [
    {
      "Id": "q_last_verse",
      "Template": "HoldOut",
      "Title": "Hold Him Steady",
      "Objective": "Hold the three galleries while Maud Sorrel keeps the god asleep.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": 3,
        "WaveCollective": "co_antiphon",
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_maud",
      "Reward": {
        "Xp": 760,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three galleries and one old woman at the altar, dears. Keep them off me until he settles.",
          "VoiceId": null,
          "Delivery": null
        },
        "Accept": {
          "Text": "Good. Don\u0027t let them pull me off the stone.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Then I\u0027ll hold him as long as I can on my own, dear.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "There. He\u0027s settled, and the rite has nothing left to pull on.",
          "VoiceId": null,
          "Delivery": null
        },
        "Fail": {
          "Text": "I\u0027m down, dears. Pick me up, or the Verger\u0027s rite gets its way.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "RoomEnter",
      "Room": 1,
      "Line": {
        "Text": "Maud Sorrel sits at the altar with her hands flat on the stone, holding the god asleep. From the next gallery comes the Verger\u0027s voice, praying for the god to wake. Keep the Sleepless\u0027s kind off her.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Trigger": "RoomEnter",
      "Room": 1,
      "Line": {
        "Text": "Forty years the Verger prayed to Gorm and was never answered. The orc promised him a god who would answer, and for that the Verger opened the crypt door. Now he prays that god through.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Trigger": "RoomEnter",
      "Room": 1,
      "Line": {
        "Text": "The floor here will not stop shaking. Gorm is nearer waking for the strength he promised you, and more of the Sleepless\u0027s kind are getting through.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": "wake_gorm",
      "ForbidsFlag": null
    },
    {
      "Trigger": "RoomEnter",
      "Room": 1,
      "Line": {
        "Text": "Among the voices at the Verger\u0027s rite is Deacon Tobit\u0027s, slow and grey: the rite is turning him, and he repeats his master\u0027s every word. Break it, and it lets him go.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": "told_tobit"
    },
    {
      "Trigger": "RoomEnter",
      "Room": 7,
      "Line": {
        "Text": "Absalom Quill, the Verger, kneels here with the church\u0027s silver ewer in his hands, praying aloud for the god to wake. He is the man who opened the crypt door to the orc.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Trigger": "RoomEnter",
      "Room": 7,
      "Line": {
        "Text": "Deacon Tobit kneels at his master\u0027s side, grey to the wrists and half turned, his eyes on the ewer.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": "told_tobit"
    }
  ],
  "Taunts": [
    {
      "Trigger": "RitualStart",
      "Objective": "ritual",
      "Line": {
        "Text": "Go on, warden, hold your god steady. He\u0027s half awake already, thanks to the town\u0027s hirelings, and every bloody wave I send shakes him further.",
        "VoiceId": null,
        "Delivery": null
      },
      "CleanLine": {
        "Text": "Go on, warden, hold your god steady. He\u0027s half awake already, thanks to the town\u0027s hirelings, and every wave I send shakes him further.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": "wake_gorm",
      "ForbidsFlag": null,
      "FromStock": false
    },
