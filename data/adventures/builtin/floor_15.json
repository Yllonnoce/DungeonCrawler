  "Boss": {
    "Name": "The Bellows",
    "SignatureOverride": "Charge",
    "IntroLine": {
      "Text": "The great engine of the pump works, which pushed the water down the third drain for three hundred years. The orc set it to pouring his minions instead.",
      "VoiceId": "4ab8c71eb1c17a70",
      "Delivery": null
    },
    "DeathLine": {
      "Text": "Its last stroke comes down on an empty ladle, and the orc\u0027s great engine does not lift again.",
      "VoiceId": "04003fa0cf3ef8f6",
      "Delivery": null
