  "Narration": [
    {
      "Trigger": "BossSeen",
      "Room": null,
      "Line": {
        "Text": "The Bellows heaves over the choked drain, and fresh iron drops hissing from its ladles to come at you. Stop the engine and the drain can run.",
        "VoiceId": "d6fb2a43a2b42073",
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Trigger": "BossDead",
      "Room": null,
      "Line": {
        "Text": "You turn the sluice wheel under the dead engine, and the third great drain runs. The heat goes out of the works, the shaking above you eases, and the god drinks. One great drain left.",
        "VoiceId": "a5ac23e0088ec736",
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Taunts": [
    {
      "Trigger": "Descend",
      "Objective": null,
      "Line": {
        "Text": "Three drains, hirelings. Count your bloody wages. My foundry finished me before you broke it: I am whole again, larger, and waiting for you at the last drain.",
