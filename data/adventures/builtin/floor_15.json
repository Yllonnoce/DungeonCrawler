  "Boss": {
    "Name": "The Iron Colossus",
    "SignatureOverride": "Charge",
    "IntroLine": {
      "Text": "I am the Mourner. This colossus is but a mouth. Hale\u0027s suffering gave me form; you will give me release. Offer me his soul, or I will gorge on yours.",
      "VoiceId": "62c0ee03199f8449"
    },
    "DeathLine": {
      "Text": "The colossus shatters, but my voice will follow you into the deep. The grief does not end.",
