    {
      "Trigger": "BossSeen",
      "Room": null,
      "Line": {
        "Text": "The iron giant\u0027s eyes glow with a green flame. Its voice is the Mourner\u0027s\u2014soft, layered with centuries of sorrow.",
        "VoiceId": "58fbdf3b424b9d36"
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Trigger": "BossSeen",
      "Room": null,
      "Line": {
        "Text": "The Mourner stirs. \u0027You have spilled the warden\u0027s blood. His grief is mine already. Now, give me yours.\u0027",
        "VoiceId": "13afb795584845d3"
      },
      "RequiresFlag": "killed_hale",
      "ForbidsFlag": null
    },
    {
      "Trigger": "BossSeen",
      "Room": null,
      "Line": {
        "Text": "\u0027The warden still breathes. You defy me. Then I shall feast on your despair instead.\u0027",
        "VoiceId": "e41c29c16365c822"
      },
      "RequiresFlag": "spared_hale",
      "ForbidsFlag": null
    },
    {
      "Trigger": "BossDead",
      "Room": null,
      "Line": {
        "Text": "The colossus falls, and the kiln\u0027s heat dies. Yet a cold voice lingers in your mind.",
