        ],
        "ClueName": "casting moulds"
      },
      "GiverNpc": "npc_ulf",
      "Reward": {
        "Xp": 300,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three patterns off the shelves, that\u0027s all. The hall, the hole behind it, and the one they keep by the stair. Don\u0027t drop them; a cracked mould pours crooked.",
          "VoiceId": null,
          "Delivery": null
        },
        "Accept": {
          "Text": "Good. Flat, mind, and keep your thumbs out of the sand.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Suit yourselves. They\u0027ll get poured whether you look at them or not. Everything here does.",
          "VoiceId": "dc11281fd58a8607",
          "Delivery": null
        },
        "Complete": {
          "Text": "A crushing wall. A spike bed. The orc himself, larger. I poured them all. Help me break them.",
          "VoiceId": null,
          "Delivery": null
        },
        "Fail": {
          "Text": "Left them lying, did you. Well. There\u0027s plenty more on the shelves.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "RoomEnter",
      "Room": 4,
      "Line": {
        "Text": "Shelf upon shelf of casting moulds. Up close you can make out what they are for: the face of a crushing wall, the teeth of a spike bed, the limbs of the iron brutes.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Trigger": "RoomEnter",
      "Room": 2,
      "Line": {
        "Text": "By the stair stands the biggest mould in the works, taller than two men: the orc\u0027s own shape, larger than the body you killed at the gate. This is where he was poured again.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Taunts": [
    {
      "Trigger": "FloorEnter",
      "Objective": "jailbreak",
      "Line": {
        "Text": "More of the town in my cages, hirelings, and my old founder minding his shelves next door. Free them if you like. He won\u0027t look up; he never does.",
        "VoiceId": null,
        "Delivery": null
      },
      "CleanLine": {
        "Text": "More of the town in my cages, hirelings, and my old founder minding his shelves next door. Free them if you like. He won\u0027t look up; he never does.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "FromStock": false
    },
    {
      "Trigger": "Descend",
      "Objective": null,
      "Line": {
        "Text": "So now you\u0027ve seen my shelves, hirelings: the walls, the spikes, the iron, all mine. My founder poured every one with his bad eyes, and the big mould by the stair is me.",
        "VoiceId": null,
        "Delivery": null
      },
      "CleanLine": {
        "Text": "So now you\u0027ve seen my shelves, hirelings: the walls, the spikes, the iron, all mine. My founder poured every one with his bad eyes, and the big mould by the stair is me.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
