  "Quests": [
    {
      "Id": "q_moulds",
      "Template": "Investigate",
      "Title": "The Good Ones",
      "Objective": "Bring Old Ulf three casting moulds from the shelves of the Mould Room",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [
          6,
          4,
          2
        ],
        "ClueName": "a casting mould with a face in it"
      },
      "GiverNpc": "npc_ulf",
      "Reward": {
        "Xp": 300,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three patterns off the shelves, that\u0027s all. The hall, the sand cupboard, and the one they keep by the stair. Don\u0027t drop them; the sand remembers being dropped.",
          "VoiceId": "6f57eb875a88a136",
          "Delivery": null
        },
        "Accept": {
          "Text": "Good. Flat, mind, and don\u0027t breathe on them. A breath puts a dimple in a cheek and then he\u0027s got a dimple for life.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Suit yourselves. They\u0027ll get poured whether you look at them or not. Everything here does.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "Ah, now. That\u0027s a Sorrel nose. That\u0027s a Dunmarrow chin, Fenn or Fenwick. And that one\u0027s a Crane; Hesketh\u0027s grandson, by the brow. Not born yet, mind. The sand has him first. Proud work, that.",
          "VoiceId": "ff36d9df63b1f49d",
          "Delivery": null
        },
        "Fail": {
          "Text": "Left them lying, did you. They\u0027ll cool crooked and some poor soul will walk about wrong for sixty years and never know why.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
