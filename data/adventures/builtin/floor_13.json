  "Npcs": [
    {
      "Id": "npc_ulf",
      "Name": "Old Ulf",
      "Room": 6,
      "VoiceId": "Orus",
      "Script": {
        "Start": "u1",
        "Nodes": [
          {
            "Id": "u1",
            "Line": {
              "Text": "Mind the shelves, mind the shelves. Forty years I\u0027ve kept this sand dry and you come in dripping. Come on, then. Have a look at the good ones.",
              "VoiceId": "260adb432df7c2dc",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What are you casting down here, old man?",
                "Next": "u2",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "We\u0027re not here for pottery.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "It is done.",
                "Next": "u3",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "u2",
            "Line": {
              "Text": "Tools, lad. Ladles, hinges, hasps. Only the patterns have got faces this season, and I can\u0027t read half of them with my eyes gone. Fetch me three off the shelves and I\u0027ll name them for you.",
              "VoiceId": "52fed9c6bf1e1ca7",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll bring your moulds.",
                "Next": "u3",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Keep your sand. We\u0027ve stairs to find.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "u3",
            "Line": {
              "Text": "Carry them flat. Tip one and you\u0027ve lost a chin, and a chin is the hardest thing in the world to put back.",
              "VoiceId": "2e7387bd67cc834e",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Here. Three faces, flat as you asked.",
                "Next": null,
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Later. They\u0027re heavy.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q_moulds",
      "CastId": "cast_ulf",
      "Persona": {
        "VoiceStyle": "a cheerful old founder, soot in his beard, proud of forty years\u0027 work and deaf to what it means",
        "DefaultDelivery": "cheerful",
