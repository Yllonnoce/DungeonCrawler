  "Npcs": [
    {
      "Id": "npc_ulf",
      "Name": "Old Ulf",
      "Room": 4,
      "VoiceId": "Orus",
      "Script": {
        "Start": "u1",
        "Nodes": [
          {
            "Id": "u1",
            "Line": {
              "Text": "Mind the shelves, mind the shelves. Forty years I\u0027ve kept this sand dry and you come in dripping. Come on, then. Have a look at the good ones.",
              "VoiceId": "260adb432df7c2dc",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What are you casting down here, old man?",
                "Next": "u2",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "We\u0027re not here for pottery.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Your moulds, old man. Look at them properly.",
                "Next": "u4",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "u2",
            "Line": {
              "Text": "Tools, lad. Plates, springs, hinges, great iron limbs, all for my customer. My eyes can\u0027t read the patterns any more. Fetch me three off the shelves and I\u0027ll name them under the lamp.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll bring your moulds.",
                "Next": "u3",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Keep your sand. We\u0027ve stairs to find.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "u3",
            "Line": {
              "Text": "Carry them flat. Tip one and the sand cracks, and a cracked mould pours crooked.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Here. Three moulds, flat as you asked.",
                "Next": "u4",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Later. They\u0027re heavy.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": {
              "Member": "Sable",
              "Line": {
                "Text": "Flat, darling? I once carried a duke\u0027s mirror down a drainpipe.",
                "VoiceId": null,
                "Delivery": null
              }
            }
          },
          {
            "Id": "u4",
            "Line": {
              "Text": "That\u0027s a crushing wall. That\u0027s a spike bed. That\u0027s an arm off one of those iron brutes. And the big one by the stair, the last I poured, is the orc himself, larger. I called every one good work.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "You didn\u0027t know.",
                "Next": "u5",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "So you built the orc\u0027s traps.",
                "Next": "u5",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "u5",
            "Line": {
              "Text": "No excuses. I took the gold and never once asked what it was for. Help me break them, every mould on these shelves, and the orc\u0027s first.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Your journeyman Oskar knew.",
                "Next": "u6",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Break them, old man. We\u0027ve a drain to clear.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "u6",
            "Line": {
              "Text": "Oskar saw the whole drawings; I only ever saw the parts. If that lad kept quiet, it was the orc made him. Don\u0027t you blame him.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Break them, old man. We\u0027ve a drain to clear.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "q_moulds",
      "CastId": "cast_ulf",
      "Persona": {
        "VoiceStyle": "a jovial old founder, soot in his beard, proud of his work and deaf to what it means",
        "DefaultDelivery": "cheerful",
