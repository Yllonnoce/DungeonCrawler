  "Npcs": [
    {
      "Id": "npc_hollis2",
      "Name": "Hollis Penn",
      "Room": 2,
      "VoiceId": "Orus",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Well. Here you are, and here\u0027s the door, and behind it the ledger the Company sent me down to keep shut. Yes. That was the job. The Company thanks you for the road. Go home now. Please.",
              "VoiceId": "ee28a538b50dd68d",
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "You were sent to keep it shut?",
                "Next": "why",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Give us the ledger, Hollis.",
                "Next": null,
                "Effect": "Betray",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Fine. We go home.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "why",
            "Line": {
              "Text": "Ashmere owed the Company more than a town\u0027s worth. Somebody rang a bell and the debt drowned. The book says who. You don\u0027t want the book. Nobody who pays your wages wants you to have the book.",
              "VoiceId": "ea1f0551801aaeee",
              "Delivery": "weary"
            },
            "Choices": [
              {
                "Text": "Give us the ledger, Hollis.",
                "Next": null,
                "Effect": "Betray",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "We\u0027ll think about it.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "quest_hollis",
      "CastId": "cast_hollis",
      "Persona": {
        "VoiceStyle": "a brisk, chummy company man, all smiles and quick sums, never quite looking at you",
        "DefaultDelivery": "cheerful",
