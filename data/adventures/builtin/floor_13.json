        "ClueName": null
      },
      "GiverNpc": "npc_hollis2",
      "Reward": {
        "Xp": 420,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "The Company thanks you for the road. Go home now. Please.",
          "VoiceId": "78069cbd87c1ff1c",
          "Delivery": "calm"
        },
        "Accept": {
          "Text": "Then it\u0027s like that.",
          "VoiceId": null,
          "Delivery": "angry"
        },
        "Decline": {
          "Text": "Thank you. Truly. Go up.",
          "VoiceId": null,
          "Delivery": "warm"
        },
        "Complete": {
          "Text": "The golems fall apart like cheap coin. Hollis Penn is nowhere, and the door is yours.",
          "VoiceId": "3f75a5d626eae1f9",
          "Delivery": "calm"
        },
        "Fail": {
          "Text": "The door stays shut, and Hollis with it.",
          "VoiceId": null,
          "Delivery": "weary"
        }
      },
      "RequiresFlag": null,
