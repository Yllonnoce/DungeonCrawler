  "Quests": [
    {
      "Id": "q_moulds",
      "Template": "Investigate",
      "Title": "The Good Ones",
      "Objective": "Bring Old Ulf three casting moulds from the shelves of the Mould Room",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [
