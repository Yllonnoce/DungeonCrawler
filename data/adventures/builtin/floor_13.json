  "Quests": [
    {
      "Id": "quest_hollis",
      "Template": "Betrayal",
      "Title": "The Company\u0027s Man",
      "Objective": "Hollis Penn has turned. Put down the golems he has hidden behind, and take the door.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
