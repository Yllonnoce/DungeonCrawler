  "Npcs": [
    {
      "Id": "npc1",
      "Name": "Ilse the Smith",
      "Room": 2,
      "VoiceId": "Leda",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "You... you are alive. Thank the depths. Do not come closer with that torch, my eyes are not used to it.",
              "VoiceId": "9410d6695031bb70"
            },
            "Choices": [
              {
                "Text": "What happened to you?",
                "Next": "offer",
                "Effect": "None"
              },
              {
                "Text": "It is done.",
                "Next": "done",
                "Effect": "TurnIn"
              },
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "offer",
            "Line": {
              "Text": "They know I am here. The Red Hoods come in waves whenever I make a sound, and I cannot keep quiet forever. Stand with me through the next two and I will pay you from what I have hidden.",
              "VoiceId": "80eb37a33f36420d"
            },
            "Choices": [
              {
                "Text": "I will do it.",
                "Next": "accepted",
                "Effect": "AcceptQuest"
              },
              {
                "Text": "Not now.",
                "Next": null,
                "Effect": "DeclineQuest"
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Then here they come. Do not let them reach me.",
              "VoiceId": "54c82af0e9db163d"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "It is quiet. Truly quiet. I had forgotten what that felt like. Take what I promised.",
              "VoiceId": "1b811a38678b7d0a"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell"
              }
            ]
          }
        ]
      },
      "QuestId": "quest1"
    }
  ],
  "Quests": [
    {
      "Id": "quest1",
      "Template": "HoldOut",
      "Title": "Hold the Line",
      "Objective": "Stand with Ilse the Smith against two waves of the Red Hoods.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": 2,
        "WaveCollective": "band1"
      },
      "GiverNpc": "npc1",
      "Reward": {
        "Xp": 580,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "They know I am here. The Red Hoods come in waves whenever I make a sound, and I cannot keep quiet forever. Stand with me through the next two and I will pay you from what I have hidden.",
          "VoiceId": "80eb37a33f36420d"
        },
        "Accept": {
          "Text": "Then here they come. Do not let them reach me.",
          "VoiceId": "54c82af0e9db163d"
        },
        "Decline": {
          "Text": "Then leave me. Others will come, or they will not.",
          "VoiceId": "7e360bc52d225601"
        },
        "Complete": {
          "Text": "It is quiet. Truly quiet. I had forgotten what that felt like. Take what I promised.",
          "VoiceId": "1b811a38678b7d0a"
        },
        "Fail": {
          "Text": "You left me. I will not forget that.",
          "VoiceId": "4c6ae15c42755f38"
        }
      }
    }
