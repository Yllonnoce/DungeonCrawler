  "Npcs": [
    {
      "Id": "npc_grisel",
      "Name": "Grisel Thorn",
      "Room": 7,
      "VoiceId": "Aoede",
      "Script": {
        "Start": "g1",
        "Nodes": [
          {
            "Id": "g1",
            "Line": {
              "Text": "You found them. That\u0027s my crew in the cages: taken first, nearly grey, nearly gone. Walk me through to the stair and keep the jailers off me, and I\u0027ll bring them out as we go.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Walk with us. We\u0027ll get them out.",
                "Next": "g2",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Stay put. You\u0027d slow us down.",
                "Next": "g3",
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "There. The stair. Go up it or down it, but go.",
                "Next": "g4",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "g2",
            "Line": {
              "Text": "Right. Keep me between you and the iron. They still know my voice, most of them. I\u0027ll call them out one at a time.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Move.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "g3",
            "Line": {
              "Text": "Fair. I\u0027d have left me too. Get them out without me, then, and tell them Grisel was here.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Keep your head down.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "g4",
            "Line": {
              "Text": "That\u0027s the stair. I\u0027ll wait here for my crew and take them up myself. Don\u0027t wait for me to thank you properly; I\u0027m out of practice.",
              "VoiceId": null,
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Mind yourself, Grisel.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "q_grisel_out",
      "CastId": "cast_grisel",
      "Persona": {
        "VoiceStyle": "a drain-warden months alone underground: flat, wry, short sentences, says the worst about herself first",
        "DefaultDelivery": "weary",
