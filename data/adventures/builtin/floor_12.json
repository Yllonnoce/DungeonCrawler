  "Npcs": [
    {
      "Id": "npc_grisel",
      "Name": "Grisel Thorn",
      "Room": 7,
      "VoiceId": "Aoede",
      "Script": {
        "Start": "g1",
        "Nodes": [
          {
            "Id": "g1",
            "Line": {
              "Text": "Second lot usually steps over the first lot. You came back instead. I haven\u0027t decided yet whether that\u0027s kindness or bad arithmetic.",
              "VoiceId": "222db2e1c13beecb",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Walk with us. The stairs are down past the cages.",
                "Next": "g2",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Stay here. The spiders were fine with you.",
                "Next": "g3",
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "There. The stair. Go up it or down it, but go.",
                "Next": "g4",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "g2",
            "Line": {
              "Text": "Keys on their belts, hooks for hands. Keep me between you and the hooks and I\u0027ll say something generous about you later, when there\u0027s a later.",
              "VoiceId": "fcb4062da06bec17",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Move.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "g3",
            "Line": {
              "Text": "Fair. I\u0027d have left me too. Mind the kiln wall by the breaches; it has been coughing all week.",
              "VoiceId": "0c90c09cf0590954",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Keep your head down.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "g4",
            "Line": {
              "Text": "Nineteen years, and it was two rooms over. I walked my own four the other way and I have been paying the difference ever since.",
              "VoiceId": "f8e6acd9ec83cd0f",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Then stop paying.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q_grisel_out",
      "CastId": "cast_grisel",
      "Persona": {
        "VoiceStyle": "nineteen years underground; flat, dry, contrary, speaks of spiders like neighbours",
        "DefaultDelivery": "weary",
        "Voice": null,
        "IsEmpty": false
      },
      "RequiresFlag": "grisel_forgiven",
      "ForbidsFlag": null,
      "Betrayal": null
    }
  ],
  "Quests": [
    {
      "Id": "q_grisel_out",
      "Template": "Escort",
      "Title": "Walking Grisel Out",
      "Objective": "Bring Grisel Thorn down to the stairs alive, past the jailers and their keys.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": "npc_grisel",
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_grisel",
      "Reward": {
        "Xp": 320,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "I know every cage on this floor by the noise it makes. What I don\u0027t know is how to cross the casting floor with company. Take me to the stair.",
          "VoiceId": "1671ff0dd94e75c2",
          "Delivery": null
        },
        "Accept": {
          "Text": "Right. Slowly, and don\u0027t look in the cages. They look back, and they have my face half-finished in there somewhere.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Suit yourself. I\u0027ve been left in worse rooms by better liars.",
          "VoiceId": null,
          "Delivery": null
        },
        "Complete": {
          "Text": "That\u0027s the stair. I\u0027ve not stood on a step going up since before you were paid. Don\u0027t wait for me to thank you properly; I\u0027m out of practice.",
          "VoiceId": "8d92cc0783a2041d",
          "Delivery": null
        },
        "Fail": {
          "Text": "Should have stayed with the spiders. They at least finish what they start.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": "grisel_forgiven",
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "Enter",
      "Room": null,
      "Line": {
        "Text": "The head jailer wears a company badge nineteen years out of date, and answers to Grisel Thorn. She does not look up. The keys on her belt do the talking.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": "grisel_forgiven"
    }
  ],
  "Taunts": [
