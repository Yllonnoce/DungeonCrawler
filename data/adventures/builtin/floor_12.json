  "Quests": [
    {
      "Id": "q_grisel_out",
      "Template": "Escort",
      "Title": "Grisel\u0027s Crew",
      "Objective": "Bring Grisel Thorn down to the stairs alive, past the jailers, while her crew are freed.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": "npc_grisel",
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_grisel",
      "Reward": {
        "Xp": 320,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "I know every cage on this floor by the noise it makes. Get me across the casting floor to the stair, and I\u0027ll bring my crew out as we go.",
          "VoiceId": null,
          "Delivery": null
        },
        "Accept": {
          "Text": "Right. Slowly. They\u0027ll know my voice before they know my face.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Suit yourself. I\u0027ve been left in worse rooms by better liars.",
          "VoiceId": "e609345ca049206d",
          "Delivery": null
        },
        "Complete": {
          "Text": "That\u0027s the stair. I\u0027ll wait here and take my crew up myself, every one you bring me. Don\u0027t wait for thanks; I\u0027m out of practice.",
          "VoiceId": null,
          "Delivery": null
        },
        "Fail": {
          "Text": "Get them out. Don\u0027t you leave them now.",
          "VoiceId": null,
          "Delivery": null
        }
      },
      "RequiresFlag": "grisel_forgiven",
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "RoomEnter",
      "Room": 11,
      "Line": {
        "Text": "The cages hold Grisel Thorn\u0027s crew, taken first in the spring and nearly gone: grey to the eyes and past speaking. A few days more and they would be running with the cinders.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    },
    {
      "Trigger": "RoomEnter",
      "Room": 11,
      "Line": {
        "Text": "Grisel Thorn lies dead by the cage door, the orc\u0027s keys still on her belt. She took them to save herself and kept her own crew locked in; when you came for the cages, his iron cut her down.",
        "VoiceId": null,
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": "grisel_forgiven"
    }
  ],
