        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "More of my master\u0027s letters are lying in these halls. Bring them to me and I\u0027ll read them; I\u0027m thorough. I always am.",
          "VoiceId": "9fc42e559dab0cd3",
          "Delivery": null
        },
        "Accept": {
          "Text": "Thank you. Mind the marble where it\u0027s cracked; things come through the cracks down here.",
          "VoiceId": "d2fc68ab442f5e7f",
          "Delivery": null
        },
        "Decline": {
          "Text": "No. Quite right. I\u0027ll look for them myself, slowly.",
          "VoiceId": "5a17fd3cfbfb5697",
          "Delivery": null
        },
        "Complete": {
          "Text": "His letters, every one. Now I know why he did it.",
          "VoiceId": "bd55d5a662db8a57",
          "Delivery": null
        },
        "Fail": {
          "Text": "Then I\u0027ll never know why. I\u0027ll have to make do with knowing that he did.",
          "VoiceId": "0542ae9fa5427dcd",
          "Delivery": null
        }
      },
      "RequiresFlag": "told_tobit",
