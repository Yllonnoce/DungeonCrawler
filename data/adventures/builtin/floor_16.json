  "Npcs": [
    {
      "Id": "npc_el",
      "Name": "Elowen",
      "Room": 4,
      "VoiceId": "Despina",
      "Script": {
        "Start": "start",
        "Nodes": [
          {
            "Id": "start",
            "Line": {
              "Text": "I know why you\u0027ve come. The relic... it\u0027s here, with me. But I\u0027ll only give it if you swear to end my father\u0027s suffering. He\u0027s in so much pain, trapped between life and death. Promise me.",
              "VoiceId": "57d3e00919cd435b"
            },
            "Choices": [
              {
                "Text": "We promise to end his suffering.",
                "Next": "promise",
                "Effect": "Choose",
                "Flag": "promised_el",
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "We can\u0027t make that promise.",
                "Next": "refuse",
                "Effect": "Choose",
                "Flag": "refused_el",
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "promise",
            "Line": {
              "Text": "Then take it. Use it to put him to rest. And... thank you.",
              "VoiceId": "42eba666ef829249"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "refuse",
            "Line": {
              "Text": "Then leave me. I\u0027ll carry this burden alone, and the relic stays with me.",
              "VoiceId": "0fd1aaa3da89a4f0"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "quest_el_promise",
      "CastId": null,
      "RequiresFlag": null,
