  "Npcs": [
    {
      "Id": "npc_tobit_16",
      "Name": "Deacon Tobit Hale",
      "Room": 5,
      "VoiceId": "Orus",
      "Script": {
        "Start": "t1",
        "Nodes": [
          {
            "Id": "t1",
            "Line": {
              "Text": "I found it. My master\u0027s letter to the orc, in his own hand: \u0027The way will be open by midwinter.\u0027 He opened the crypt door to that thing. I want him stopped.",
              "VoiceId": "3bc0b4d21459d4c2",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What do you need from us?",
                "Next": "t2",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Your master\u0027s letters, deacon.",
                "Next": "t4",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Stay behind us, deacon.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "t2",
            "Line": {
              "Text": "There are more of his letters in these halls, dropped where the orc\u0027s creatures came through. Bring them to me. Before anyone stops him, I want to know why he did it.",
              "VoiceId": "e5883968e4a89036",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll find them.",
                "Next": "t3",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Find them yourself, deacon.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Here. Every letter we found.",
                "Next": "t4",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Later, deacon.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "t3",
            "Line": {
              "Text": "Thank you. Mind the marble where it\u0027s cracked; things come through the cracks down here.",
              "VoiceId": "d2fc68ab442f5e7f",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Keep your head down, deacon.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "t4",
            "Line": {
              "Text": "\u0027You promised the god who comes through will reward the man who opens the door. Forty years Gorm never once answered me.\u0027 That\u0027s why. He wanted a god who answers.",
              "VoiceId": "15c846b8ac1785c1",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Then we\u0027ll stop him.",
                "Next": "t5",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "t5",
            "Line": {
              "Text": "Thank you. I\u0027ll take his letters up to the town, so nobody can say it was a lie. I was thorough. I always am.",
              "VoiceId": "1fd454681e67f391",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Go carefully, deacon.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "q_letter_tobit",
      "CastId": "cast_tobit",
      "Persona": {
        "VoiceStyle": "an eager young deacon, polite to a fault, delighted to have visitors at last",
        "DefaultDelivery": "warm",
        "Voice": "Puck",
        "IsEmpty": false
      },
      "RequiresFlag": "told_tobit",
