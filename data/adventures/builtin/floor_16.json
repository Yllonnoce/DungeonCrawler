  "Npcs": [
    {
      "Id": "npc_tobit_16",
      "Name": "Deacon Tobit Hale",
      "Room": 5,
      "VoiceId": "Orus",
      "Script": {
        "Start": "t1",
        "Nodes": [
          {
            "Id": "t1",
            "Line": {
              "Text": "You told me the truth on the flagstones and I have been no use to anyone since. They gave me a letter for the council and told me not to read it. I read it.",
              "VoiceId": "a57e6dcc71a555db",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What was in it, deacon?",
                "Next": "t2",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Keep it. We have stairs to find.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "It is done.",
                "Next": "t2",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "t2",
            "Line": {
              "Text": "I tore it into three and scattered it down three halls, which I now see was the act of a coward with very good handwriting. Bring the pieces and I will read it aloud.",
              "VoiceId": "1a0aac161b6b122a",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll gather your courage for you.",
                "Next": "t3",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Three pieces. Here.",
                "Next": "t3",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Tear up something else. We\u0027re busy.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "t3",
            "Line": {
              "Text": "Then stand where the pillars fell and let me say it where the Choir can hear. I would rather be wrong out loud than obedient in a whisper.",
              "VoiceId": "c474da0639f7f08f",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Say it, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q_letter_tobit",
      "CastId": "cast_tobit",
      "Persona": {
        "VoiceStyle": "a young deacon, earnest and bookish, courteous past all sense, voice thinning when he means it",
        "DefaultDelivery": "pleading",
        "Voice": null,
        "IsEmpty": false
      },
      "RequiresFlag": "told_tobit",
      "ForbidsFlag": null,
      "Betrayal": null
    },
    {
      "Id": "npc_maud_16",
      "Name": "Maud Sorrel",
      "Room": 9,
      "VoiceId": "Despina",
      "Script": {
        "Start": "m1",
        "Nodes": [
          {
            "Id": "m1",
            "Line": {
              "Text": "I walked this hall asleep an hour ago and something fell out of my sleeve. A letter. I don\u0027t write letters. I only carry things as far as the water.",
              "VoiceId": "22f7149bb6fc21c5",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Whose letter, Maud?",
                "Next": "m2",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Dry feet in a pond. We\u0027ll not ask.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "It is done.",
                "Next": "m2",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "m2",
            "Line": {
              "Text": "It went to pieces in three halls, the way paper does down here. The young deacon\u0027s voice is in the Choir now, so he cannot fetch them. Fetch them, and I will know what I was carrying.",
              "VoiceId": "81838ba5f8eda31a",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll walk the ring for you.",
                "Next": "m3",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Three pieces. Here.",
                "Next": "m3",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Carry your own post.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "m3",
            "Line": {
              "Text": "Read it to me slowly, when you have it. He likes being read to. It is the nearest thing to a voice He has had in three hundred years.",
              "VoiceId": "202ab9846f5dc4ee",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Slowly, then.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q_letter_maud",
      "CastId": "cast_maud",
      "Persona": {
        "VoiceStyle": "an old woman speaking half-asleep, unhurried, kind, never startled by anything at all",
        "DefaultDelivery": "calm",
        "Voice": null,
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": "told_tobit",
      "Betrayal": null
    }
  ],
  "Quests": [
    {
      "Id": "q_letter_tobit",
      "Template": "Investigate",
      "Title": "The Torn Letter",
      "Objective": "Gather the three pieces of the Verger\u0027s letter from the marble halls and bring them to Tobit.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [
          5,
          8,
          9
        ],
        "ClueName": "a torn piece of the Verger\u0027s letter"
      },
      "GiverNpc": "npc_tobit_16",
      "Reward": {
        "Xp": 420,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three pieces, three halls. I was thorough. I am always thorough; it is my only virtue and it has never once helped anybody.",
          "VoiceId": "157b217d4f4f0f95",
          "Delivery": null
        },
        "Accept": {
          "Text": "Thank you. Mind the colonnade; the singers use the fallen pillars the way I used to use the pulpit.",
          "VoiceId": "b16a90fa22630734",
          "Delivery": null
        },
        "Decline": {
          "Text": "No. Quite right. Letters have done enough damage in this church.",
          "VoiceId": "0c0bf03c372226c9",
          "Delivery": null
        },
        "Complete": {
          "Text": "\u0027Send the usual. Something fierce this time; He stirs.\u0027 His hand, your alderman\u0027s seal. The usual, he writes. You are the usual, and so, one day, am I.",
          "VoiceId": "750e889cf25ef4c3",
          "Delivery": null
        },
        "Fail": {
          "Text": "Leave them scattered, then. The Choir will learn the words soon enough; it learns everything eventually.",
          "VoiceId": "abefa1678366cf4e",
          "Delivery": null
        }
      },
      "RequiresFlag": "told_tobit",
      "ForbidsFlag": null
    },
    {
      "Id": "q_letter_maud",
      "Template": "Investigate",
      "Title": "What She Was Carrying",
      "Objective": "Gather the three pieces of the Verger\u0027s letter from the marble halls and bring them to Maud.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [
          5,
          8,
          9
        ],
        "ClueName": "a torn piece of the Verger\u0027s letter"
      },
      "GiverNpc": "npc_maud_16",
      "Reward": {
        "Xp": 420,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three pieces in three halls. I would fetch them myself, but I only go downward, and never twice over the same stone.",
          "VoiceId": "7c83b76808a2f452",
          "Delivery": null
        },
        "Accept": {
          "Text": "Good. Keep to the outer ring. The singers are fond of the middle, and so, I think, is the one beneath it.",
          "VoiceId": "463e871994d2007b",
          "Delivery": null
        },
        "Decline": {
          "Text": "As you like. It will still be there when you come back up, and so will I, which is the sadder of the two facts.",
          "VoiceId": "2b2f09e95a1ee020",
          "Delivery": null
        },
        "Complete": {
          "Text": "\u0027Send the usual. Something fierce this time; He stirs.\u0027 The verger\u0027s hand, the council\u0027s seal. You were ordered, dears. You were not hired.",
          "VoiceId": "ec911ea0e51385fb",
          "Delivery": null
        },
        "Fail": {
          "Text": "Paper rots quickly in a throat. No matter. I remember the wording; I have been carrying it since before you were apprenticed.",
          "VoiceId": "4bea74352574648b",
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": "told_tobit"
    }
  ],
