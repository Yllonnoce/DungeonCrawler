    {
      "Id": "npc_maud_16",
      "Name": "Maud Sorrel",
      "Room": 9,
      "VoiceId": "Gacrux",
      "Script": {
        "Start": "m1",
        "Nodes": [
          {
            "Id": "m1",
            "Line": {
              "Text": "There you are, dears. Keep the water going down to Gorm; that\u0027s all I want. And here: this came down to me on the water. The Verger\u0027s letter to the orc: \u0027The way will be open by midwinter.\u0027",
              "VoiceId": "f7af0d36e07d535d",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Where\u0027s the deacon, Maud?",
                "Next": "m2",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "What else came down the water?",
                "Next": "m3",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "The Verger\u0027s letters, Maud.",
                "Next": "m4",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "m2",
            "Line": {
              "Text": "Taken for the rite, dear. His master sent for him, and he went down gladly. The Verger\u0027s the one who opened the crypt door to the orc, and he means to wake the god.",
              "VoiceId": "9bb7eddd38ffc651",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What else came down the water?",
                "Next": "m3",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "m3",
            "Line": {
              "Text": "More of his letters, dear, spread through these halls by the water. Bring them to me. The deacon would want to know why his master did it, and so would I.",
              "VoiceId": "35119e2e53dede5f",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll fetch them.",
                "Next": "m5",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Fetch them yourself, Maud.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Here. Every letter we found.",
                "Next": "m4",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Later, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "m4",
            "Line": {
              "Text": "\u0027You promised the god who comes through will reward the man who opens the door. Forty years Gorm never once answered me.\u0027 That\u0027s why, dear. He took the first answer that came.",
              "VoiceId": "484b84642f4f9570",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "m5",
            "Line": {
              "Text": "Good. Mind the marble where it\u0027s cracked, dears; things come through the cracks down here.",
              "VoiceId": "c899d050b276963f",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
