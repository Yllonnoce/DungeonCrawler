  "Barks": [
    {
      "Member": "Brand",
      "Lines": [
        {
          "Trigger": "Kill",
          "Line": {
            "Text": "Another one down. They don\u0027t learn.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Kill",
          "Line": {
            "Text": "Grief makes a poor shield.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Kill",
          "Line": {
            "Text": "Rest now. You\u0027re free of this place.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Hurt",
          "Line": {
            "Text": "A scratch. I\u0027ve had worse.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Hurt",
          "Line": {
            "Text": "Pain\u0027s an old friend by now.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Hurt",
          "Line": {
            "Text": "Is that all the sorrow you can wield?",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Loot",
          "Line": {
            "Text": "Supplies. Good. We\u0027ll need them.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Loot",
          "Line": {
            "Text": "Coin won\u0027t buy back what we lost.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Loot",
          "Line": {
            "Text": "This place hoards its dead and its gold.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "LevelUp",
          "Line": {
            "Text": "Each victory hardens the soul.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "LevelUp",
          "Line": {
            "Text": "Stronger. If only strength sufficed.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "LevelUp",
          "Line": {
            "Text": "The weight grows heavier, but so do I.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "So this is the heart of sorrow.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "Big one. Let it mourn its last.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "I\u0027ve faced worse grief than this beast.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Possess",
          "Line": {
            "Text": "Get out of my head!",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Possess",
          "Line": {
            "Text": "Their sorrow... it\u0027s so heavy.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Possess",
          "Line": {
            "Text": "I feel their loss. All of it.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Downed",
          "Line": {
            "Text": "Can\u0027t... hold it off...",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Downed",
          "Line": {
            "Text": "The darkness pulls me down.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Downed",
          "Line": {
            "Text": "Not... like this...",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Revived",
          "Line": {
            "Text": "Back from the brink. Again.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Revived",
          "Line": {
            "Text": "Death declined. The work\u0027s not done.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Revived",
          "Line": {
            "Text": "I thought I heard her calling. But no.",
            "VoiceId": null
          }
        }
      ]
    },
    {
      "Member": "Sable",
      "Lines": [
        {
          "Trigger": "Kill",
          "Line": {
            "Text": "Slipped right through their grief.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Kill",
          "Line": {
            "Text": "Dead men tell no tales. Pity.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Kill",
          "Line": {
            "Text": "A quick knife is a kindness here.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Hurt",
          "Line": {
            "Text": "That\u0027ll leave a mark. Add it to the collection.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Hurt",
          "Line": {
            "Text": "Careful! This coat was expensive.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Hurt",
          "Line": {
            "Text": "Blood and sorrow. Same old song.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Loot",
          "Line": {
            "Text": "Shiny. They won\u0027t miss it.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Loot",
          "Line": {
            "Text": "Treasured trinkets of the damned.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Loot",
          "Line": {
            "Text": "I\u0027ll lighten this load. For their sake.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "LevelUp",
          "Line": {
            "Text": "Sharper now. Both blade and wit.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "LevelUp",
          "Line": {
            "Text": "A new trick. The dead won\u0027t see it coming.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "LevelUp",
          "Line": {
            "Text": "Practiced hands make short work of misery.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "Well, that\u0027s a big unhappy thing.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "Looks like sorrow\u0027s captain. Let\u0027s mutiny.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "Bigger they are, harder they mourn.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Possess",
          "Line": {
            "Text": "Hands... not mine. Get off!",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Possess",
          "Line": {
            "Text": "Something\u0027s wearing me like a glove.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Possess",
          "Line": {
            "Text": "I see through their eyes now.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Downed",
          "Line": {
            "Text": "That\u0027s... a bit too close.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Downed",
          "Line": {
            "Text": "No, I\u0027m not done haggling yet.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Downed",
          "Line": {
            "Text": "Down but not out... mostly down.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Revived",
          "Line": {
            "Text": "Still breathing? Pity, I\u0027d hoped to haunt you.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Revived",
          "Line": {
            "Text": "Thanks. I\u0027ll return the favor, probably.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Revived",
          "Line": {
            "Text": "Back to the living. The dead were poor company.",
            "VoiceId": null
          }
        }
      ]
    },
    {
      "Member": "Wren",
      "Lines": [
        {
          "Trigger": "Kill",
          "Line": {
            "Text": "One less sorrow in the dark.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Kill",
          "Line": {
            "Text": "Found their weakness. It was despair.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Kill",
          "Line": {
            "Text": "The hunt ends. As all hunts do.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Hurt",
          "Line": {
            "Text": "A glancing blow. I\u0027ve tracked worse.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Hurt",
          "Line": {
            "Text": "Flesh wound. Keep moving.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Hurt",
          "Line": {
            "Text": "That one almost meant something.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Loot",
          "Line": {
            "Text": "A hunter\u0027s prize. Waste not.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Loot",
          "Line": {
            "Text": "Even the dead leave provisions.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Loot",
          "Line": {
            "Text": "Strange seeds in this soil.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "LevelUp",
          "Line": {
            "Text": "My senses sharpen. The path grows clearer.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "LevelUp",
          "Line": {
            "Text": "A hunter\u0027s stride. The quarry won\u0027t outrun me.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "LevelUp",
          "Line": {
            "Text": "Grief has its own trail to follow.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "The apex of this sad descent.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "That one\u0027s sorrow will flood the room.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "Steady aim. Big target.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Possess",
          "Line": {
            "Text": "I smell wet earth and old tears.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Possess",
          "Line": {
            "Text": "The wild is calling... but wrong.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Possess",
          "Line": {
            "Text": "My own mind becomes a thicket.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Downed",
          "Line": {
            "Text": "The ground... so cold...",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Downed",
          "Line": {
            "Text": "I see the beast\u0027s den from below.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Downed",
          "Line": {
            "Text": "The hunt... ends here?",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Revived",
          "Line": {
            "Text": "I dreamt of endless forest. Not yet.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Revived",
          "Line": {
            "Text": "Woke up. The trail goes on.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "Revived",
          "Line": {
            "Text": "Still in the race. Good.",
            "VoiceId": null
          }
        }
