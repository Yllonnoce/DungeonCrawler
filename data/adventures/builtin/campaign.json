{
  "SchemaVersion": 1,
  "Source": "claude",
  "GameSeed": 1147267151474572175,
  "Title": "The Weight of Grief",
  "Synopsis": "A grief-stricken warden walled himself in a forgotten crypt with the living and the dead. The party descends to retrieve a relic, but a rival captain dogs their steps and a sorrow-eating presence stirs below.",
  "Antagonist": {
    "Name": "The Mourner",
    "Epithet": "the Grief-Eater",
    "VoiceId": null
  },
  "NarratorVoiceId": "Charon",
  "Cast": [
    {
      "Id": "cast_warden",
      "Name": "Warden Hale",
      "Role": "a grim jailer who let his prisoners starve and now longs for punishment",
      "Secret": "He orchestrated the party\u0027s descent because he wants them to kill him and end the curse; comes out on floor 14.",
      "VoiceId": null
    },
    {
      "Id": "cast_rival",
      "Name": "Captain Voss",
      "Role": "leader of a rival crew who keeps losing; boastful but competent",
      "Secret": "He was hired by the same patron for half the pay and is sabotaging the party; floor 10.",
      "VoiceId": null
    },
    {
      "Id": "cast_cartographer",
      "Name": "Lunette",
      "Role": "a cartographer mapping the wrong dungeon, convinced these are the old imperial baths",
      "Secret": "She died mapping these halls a century ago and is a ghost; floor 7.",
      "VoiceId": null
    },
    {
      "Id": "cast_heir",
      "Name": "Elowen",
      "Role": "the dead warden\u0027s daughter, come to reclaim her father\u0027s honor",
      "Secret": "She carries the relic the party seeks; floor 16.",
      "VoiceId": null
    },
    {
      "Id": "cast_scavenger",
      "Name": "Thistle",
      "Role": "a scavenger who trades in bones, always where someone died recently",
      "Secret": "He secretly serves the Mourner, delivering sorrowful souls; floor 12 (not a story floor in this outline, but hinted).",
      "VoiceId": null
    },
    {
      "Id": "cast_prisoner",
      "Name": "Garrick",
      "Role": "a shackled prisoner who claims innocence",
      "Secret": "He was the warden\u0027s torturer, and the ghosts know his face; floor 4.",
      "VoiceId": null
    }
  ],
  "Mystery": {
    "Question": "What really happened in the crypt that sealed it for a century?",
    "Truth": "Warden Hale locked the crypt during a plague outbreak, trapping both the sick and the healthy inside. The haunting is the accumulated grief of those left to die.",
    "Clues": [
      {
        "Id": "clue1",
        "Floor": 2,
        "Text": "A torn quarantine order pinned to a chapel door, dated the year of the sealing. \u0027None shall leave. By order of Warden Hale.\u0027"
      },
      {
        "Id": "clue2",
        "Floor": 5,
        "Text": "A child\u0027s rag doll with teeth marks, left in a corner of a cell. Its embroidered name reads \u0027Miri\u0027."
      },
      {
        "Id": "clue3",
        "Floor": 10,
        "Text": "A supply ledger from the warden\u0027s office, the entries stopping abruptly mid-month, followed by a scrawled note: \u0027No more supplies. We are abandoned.\u0027"
      },
      {
        "Id": "clue4",
        "Floor": 13,
        "Text": "A sealed letter of apology from Warden Hale to his daughter, unopened, the wax bearing the prison crest. \u0027Forgive me, Elowen.\u0027"
      }
    ],
    "PayoffFloor": 15,
    "Payoff": "The Mourner possesses the Iron Colossus and offers to end the haunting if the party feeds it Warden Hale\u0027s soul. The choice determines the final form of the antagonist."
  },
  "Factions": [
    {
      "Id": "crypt_wardens",
