  "Tiers": [
    {
      "Index": 0,
      "Theme": "crypt.mossy",
      "Beat": "The party descends into a forgotten catacomb, haunted by the warden\u0027s guilt and the first clues of the plague disaster.",
      "BossName": "Crypt Lord, Hale\u0027s Echo",
      "BossSignature": "Slam",
      "EnterLine": {
        "Text": "The air cools to a damp chill, and the smell of old moss and regret seeps from the walls as you step into the crypt.",
        "VoiceId": "99de634ef98f7abf"
      }
    },
    {
      "Index": 1,
      "Theme": "caves.lichen",
      "Beat": "The caves beneath the crypt are overrun with spiders and scavengers, and the rival captain Voss makes his first appearance.",
      "BossName": "The Broodmother",
      "BossSignature": "Volley",
      "EnterLine": {
        "Text": "Down into the earth, where the light goes green and the walls are crusted with glowing lichen. Something skitters in the dark.",
        "VoiceId": "475f791002330182"
      }
    },
    {
      "Index": 2,
      "Theme": "forge.kiln",
      "Beat": "The old forge still burns, guarded by the Ironkeepers. The Mourner\u0027s voice grows louder.",
      "BossName": "The Iron Colossus",
      "BossSignature": "Charge",
      "EnterLine": {
        "Text": "The heat hits you like a wall. Kilns still glow, and the clang of iron echoes from ahead.",
        "VoiceId": "355670d76bc031dc"
      }
    },
    {
      "Index": 3,
      "Theme": "abyss.slate",
      "Beat": "The abyss beneath everything, where sorrow congeals and the Mourner waits.",
      "BossName": "Abyss Herald, Mouth of the Mourner",
      "BossSignature": "Summon",
      "EnterLine": {
        "Text": "The floor drops into a chasm of black stone. The air is heavy with unshed tears, and the silence is the loudest thing you\u0027ve heard.",
        "VoiceId": "03c4df674b05aa09"
      }
    }
  ],
