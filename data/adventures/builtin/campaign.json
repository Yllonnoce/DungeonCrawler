        {
          "Trigger": "LevelUp",
          "Line": {
            "Text": "A deeper well of sorrow to draw from.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "The focal point of this grief-stricken geometry.",
