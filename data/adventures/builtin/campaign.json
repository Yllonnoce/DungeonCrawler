          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "A being of concentrated woe. Academic.",
            "VoiceId": null
          }
        },
        {
          "Trigger": "BossSeen",
          "Line": {
            "Text": "Magnificent in its despair. Let\u0027s dissect it.",
