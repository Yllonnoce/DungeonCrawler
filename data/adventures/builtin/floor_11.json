  "Npcs": [
    {
      "Id": "npc_ulf",
      "Name": "Old Ulf",
      "Room": 8,
      "VoiceId": "Orus",
      "Script": {
        "Start": "ulf_hail",
        "Nodes": [
          {
            "Id": "ulf_hail",
            "Line": {
              "Text": "Off the sand, off the sand! That\u0027s a face setting, that is, and a footprint in a face is a lifetime of squint. Now. Something\u0027s been at my coal. Something with four legs and a hot backside.",
              "VoiceId": "2ee6b93427385306",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What has been at your coal?",
                "Next": "ulf_cinders",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "The pit is quiet. Your coal is yours again.",
                "Next": "ulf_thanks",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "We\u0027re only here about the plumbing.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "ulf_cinders",
            "Line": {
              "Text": "Hounds. Three of them, slipped the pit down the slag run. They eat heat, see, and a cold forge casts slow, and slow work shows in the face. I\u0027d go myself, but I\u0027m eighty and I\u0027m busy.",
              "VoiceId": "19b9835ee1acf36f",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll put them down.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Feed them yourself, founder.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "ulf_thanks",
            "Line": {
              "Text": "Hear that? The draw\u0027s come back up. Take a cup of the small beer, it\u0027s warm on principle, and mind the shelves on your way by. Faces keep better when nobody stares.",
              "VoiceId": "8cecb96185d5ec30",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Keep casting, old man.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": "q_cinders",
      "CastId": "cast_ulf",
      "Persona": {
        "VoiceStyle": "a jovial old founder, bellows-loud, gravel and good humour, proud of every thing he casts",
        "DefaultDelivery": "cheerful",
        "Voice": null,
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    },
    {
      "Id": "npc_maud_11",
      "Name": "Maud Sorrel",
      "Room": 8,
      "VoiceId": "Gacrux",
      "Script": {
        "Start": "m11_shh",
        "Nodes": [
          {
            "Id": "m11_shh",
            "Line": {
              "Text": "Shh. Ulf is working, and he sings when he works, and I like the singing. He thinks he casts kettles. Let him; it is kind, what he thinks.",
              "VoiceId": "5b61a3853c98f383",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What does he cast, Maud?",
                "Next": "m11_faces",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Why are you asleep at an anvil?",
                "Next": "m11_warm",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "m11_faces",
            "Line": {
              "Text": "Faces, dear. Small ones. You will see them two floors down and you will wish you had not. Go on; I will be at the Dream Door before you.",
              "VoiceId": "b5713d3d323b9948",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          },
          {
            "Id": "m11_warm",
            "Line": {
              "Text": "It is warm, and He is loudest here, where His heart is. One sleeps where one can hear the one who dreams one. You will learn that too.",
              "VoiceId": "a25ee0ff7c605ab7",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ]
          }
        ]
      },
      "QuestId": null,
      "CastId": "cast_maud",
      "Persona": {
        "VoiceStyle": "an old woman talking in her sleep: unhurried, kind, faintly amused at the size of everything",
        "DefaultDelivery": "calm",
        "Voice": null,
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    }
  ],
  "Quests": [
    {
      "Id": "q_cinders",
      "Template": "KillTarget",
      "Title": "Cinders in the Coal",
      "Objective": "Kill the ember hounds loose in the hound pit",
      "Params": {
        "TargetCollective": "col_cinders",
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_ulf",
      "Reward": {
        "Xp": 220,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three hounds out of the pit and into my coal. Kill them and I\u0027ll show you a mould I\u0027m proud of, which is all of them, so bring patience.",
          "VoiceId": "6fef42e9ef831bc5",
          "Delivery": null
        },
        "Accept": {
          "Text": "Good lad. Go down the slag run and don\u0027t let them get behind you; they bite where the armour\u0027s thin and they know where that is.",
          "VoiceId": "95db0acf38570652",
          "Delivery": null
        },
        "Decline": {
          "Text": "Suit yourselves. They\u0027ll eat, the Forge runs cool, and somewhere up top a child comes out slow and nobody blames the hounds.",
          "VoiceId": "31ae70d695779c03",
          "Delivery": null
        },
        "Complete": {
          "Text": "There\u0027s the draw. Here, take this off the shelf for your trouble. Don\u0027t look at it too long, mind. You\u0027ll start recognising folk.",
          "VoiceId": "10e467725251b1a0",
          "Delivery": null
        },
        "Fail": {
          "Text": "Still chewing, are they. Well. I\u0027ve worked colder, and I\u0027ve worked with worse than you.",
          "VoiceId": "5d865ea47d955a24",
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
