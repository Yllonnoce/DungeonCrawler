  "Npcs": [
    {
      "Id": "npc_ulf",
      "Name": "Old Ulf",
      "Room": 8,
      "VoiceId": "Orus",
      "Script": {
        "Start": "ulf_hail",
        "Nodes": [
          {
            "Id": "ulf_hail",
            "Line": {
              "Text": "Off the sand, off the sand! I\u0027m Ulf; I keep the pump works. I\u0027ve an order to pour by morning for a customer who pays in gold, and hounds have got at my coal. Clear them off for me, you lot.",
              "VoiceId": "5d0d2ad9346337ca",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What hounds?",
                "Next": "ulf_cinders",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Who\u0027s the customer? What do you cast?",
                "Next": "ulf_customer",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "The pit is quiet. Your coal is yours again.",
                "Next": "ulf_thanks",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "We\u0027re here for the drains, old man.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "ulf_customer",
            "Line": {
              "Text": "Never met him. The orders come down the shaft wrapped in gold: plates, springs, hinges, great iron limbs. Tools, all of it. My eyes are going, so Oskar reads me the drawings.",
              "VoiceId": "33186e70bfdd9b74",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What hounds?",
                "Next": "ulf_cinders",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "We\u0027re here for the drains, old man.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "ulf_cinders",
            "Line": {
              "Text": "Ember hounds, three of them, up out of the old pit and down the slag run. They eat heat, see, and a cold forge pours slow. I\u0027d see to them myself, but I\u0027m eighty and I\u0027ve an order on.",
              "VoiceId": "88a0ed79a33a3eb5",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll put them down.",
                "Next": null,
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Feed them yourself, founder.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "ulf_thanks",
            "Line": {
              "Text": "Hear that? The draw\u0027s come back up, and the order goes out by morning. Take a cup of the small beer; it\u0027s warm on principle. And mind the shelves on your way by.",
              "VoiceId": "5c7f063caf3d6245",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Mind your eyes, old man.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": "q_cinders",
      "CastId": "cast_ulf",
      "Persona": {
        "VoiceStyle": "a jovial old founder, soot in his beard, proud of his work and deaf to what it means",
        "DefaultDelivery": "cheerful",
        "Voice": "Orus",
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null,
      "Ritualist": false
    },
    {
      "Id": "npc_maud_11",
      "Name": "Maud Sorrel",
      "Room": 8,
      "VoiceId": "Gacrux",
      "Script": {
        "Start": "m11_shh",
        "Nodes": [
          {
            "Id": "m11_shh",
            "Line": {
              "Text": "There you are, dear. I worked it out on the way down: I drowned, back in the spring. No matter. Keep the water going down to Gorm. He gets weaker every day the third drain stays shut.",
              "VoiceId": "21f96fb4f8e722a4",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What was this place, Maud?",
                "Next": "m11_faces",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "How did you drown?",
                "Next": "m11_warm",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "m11_faces",
            "Line": {
              "Text": "The pump works, dear. That big engine used to push the water down the drains. Now it drives a forge and casts things instead, and the water stands.",
              "VoiceId": "0ab6f5206381c041",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "How did you drown?",
                "Next": "m11_warm",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          },
          {
            "Id": "m11_warm",
            "Line": {
              "Text": "After the Verger\u0027s order, dear. Somebody had to keep the water moving, so I went down alone, and it had backed up deeper than I knew. Thirty-eight years a warden, and I never could swim.",
              "VoiceId": "199ca11745e914da",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "What was this place, Maud?",
                "Next": "m11_faces",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              },
              {
                "Text": "Mind how you go, Maud.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null,
                "NextIfRefused": null
              }
            ],
            "Aside": null
          }
        ]
      },
      "QuestId": null,
      "CastId": "cast_maud",
      "Persona": {
        "VoiceStyle": "an old workwoman soaked to the skin: unhurried, kind, faintly amused at her own state",
        "DefaultDelivery": "calm",
        "Voice": "Gacrux",
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null,
      "Ritualist": false
    }
  ],
  "Quests": [
    {
      "Id": "q_cinders",
      "Template": "KillTarget",
      "Title": "Hounds in the Coal",
      "Objective": "Kill the ember hounds loose in the hound pit",
      "Params": {
        "TargetCollective": "col_cinders",
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [],
        "ClueName": null
      },
      "GiverNpc": "npc_ulf",
      "Reward": {
        "Xp": 220,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "Three hounds out of the pit and into my coal. Kill them and I\u0027ll show you a mould I\u0027m proud of, which is all of them, so bring patience.",
          "VoiceId": "6fef42e9ef831bc5",
          "Delivery": null
        },
        "Accept": {
          "Text": "Good lad. Go down the slag run and don\u0027t let them get behind you; they bite where the armour\u0027s thin and they know where that is.",
          "VoiceId": "95db0acf38570652",
          "Delivery": null
        },
        "Decline": {
          "Text": "Suit yourselves. They\u0027ll eat, the forge runs cool, and my order goes out late. I\u0027ve not sent an order late in sixty years.",
          "VoiceId": "7549556a2b79acdd",
          "Delivery": null
        },
        "Complete": {
          "Text": "There\u0027s the draw. Here, take this off the shelf for your trouble. Good work, that. Everything off my shelves is.",
          "VoiceId": "840d0712f3b63446",
          "Delivery": null
        },
        "Fail": {
          "Text": "Still chewing, are they. Well. I\u0027ve worked colder, and I\u0027ve worked with worse than you.",
          "VoiceId": "5d865ea47d955a24",
          "Delivery": null
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "RoomEnter",
      "Room": 8,
      "Line": {
        "Text": "The Great Hearth. The orc\u0027s iron comes warm off the old founder\u0027s sand, and the engine that should be pumping water feeds the fire instead.",
        "VoiceId": "5c6d36826efe77c5",
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Taunts": [
    {
      "Trigger": "FloorEnter",
      "Objective": "shiftingvault",
      "Line": {
        "Text": "Welcome to my foundry, hirelings. My founder at the hearth pours my iron and never once asks what it\u0027s for. The stairs are behind my gates; work the bloody levers if you can count.",
        "VoiceId": "a2dbe5a56393c6c3",
        "Delivery": null
      },
      "CleanLine": {
        "Text": "Welcome to my foundry, hirelings. My founder at the hearth pours my iron and never once asks what it\u0027s for. The stairs are behind my gates; work the levers if you can count.",
