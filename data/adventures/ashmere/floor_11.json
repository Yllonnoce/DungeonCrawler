  "Npcs": [
    {
      "Id": "npc_nan2",
      "Name": "Nan Trellick",
      "Room": 7,
      "VoiceId": "Kore",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "There you are. This is Foundry Street, don\u0027t argue. I\u0027ve the bell-ringer\u0027s house marked, second on the left past the pond, but my legs won\u0027t do the water. Go and read me the door.",
              "VoiceId": "10592e17c8a3eb84",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll find the house.",
                "Next": "accepted",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Nan, you\u0027re standing in a foundry.",
                "Next": "foundry",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "We found the house.",
                "Next": "done",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Not today.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "foundry",
            "Line": {
              "Text": "I know what I\u0027m standing in, dear. I\u0027m standing in Ashmere. Everyone else has stopped. Go on: second on the left. There\u0027s a name cut over the door, read me it.",
              "VoiceId": "7cf3a600a0c4680d",
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "We\u0027ll find the house.",
                "Next": "accepted",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Later.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Good. The house, then the yard, then the grate where the Company sign is. Read me what\u0027s cut there and I\u0027ll put it on the map.",
              "VoiceId": "f97aba035ca6538a",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "Well? Read it. \u0027Nan Trellick, of this parish, taken by the water in the year of the bell.\u0027 Taken by... no. That\u0027s the wrong house. That\u0027s the wrong street. Give me the map, I\u0027ll... I\u0027ll find the right one.",
              "VoiceId": "4a174853b758383d",
              "Delivery": "whisper"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
