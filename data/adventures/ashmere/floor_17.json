      "GiverNpc": "npc_bell",
      "Reward": {
        "Xp": 500,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "The rope is in the lofts, cut in pieces. Would you look?",
          "VoiceId": "1510d6afe9bba11f",
          "Delivery": null
        },
        "Accept": {
          "Text": "Thank you. It was cut short. Somebody small was meant to reach it.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "No. No, of course. I\u0027m sorry I asked.",
          "VoiceId": null,
          "Delivery": "whisper"
        },
        "Complete": {
          "Text": "I tied that knot. I was nine. The Company man said ring, Ambrose, and the debt goes away.",
          "VoiceId": "d7211b7fe5798611",
          "Delivery": "whisper"
        },
        "Fail": {
          "Text": "Then she stays silent. Perhaps that\u0027s best.",
          "VoiceId": null,
          "Delivery": "weary"
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "QuestDone",
      "Room": null,
      "Line": {
        "Text": "The clerk\u0027s laugh comes down through the bell itself. The Lamplighters\u0027 Company, he says. Your paymasters. Your lantern on the knot. Do go home and tell them the toll is still owed.",
