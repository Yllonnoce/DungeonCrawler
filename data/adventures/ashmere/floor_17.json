  "Quests": [
    {
      "Id": "quest_rope",
      "Template": "Investigate",
      "Title": "The Bell-Rope",
      "Objective": "Find the three cut lengths of the bell-rope in the lofts and bring them to Ambrose Bell.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
