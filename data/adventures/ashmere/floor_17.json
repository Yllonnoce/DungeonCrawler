  "Npcs": [
    {
      "Id": "npc_bell",
      "Name": "Ambrose Bell",
      "Room": 7,
      "VoiceId": "Despina",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "You\u0027ve come down the whole way. I\u0027m sorry. I\u0027m Bell, the deacon, the ringer\u0027s son. The rope is somewhere in the lofts, cut in pieces; if I had it I could ring her again and raise the town. Would you... would you look?",
              "VoiceId": "beaac76fd33a2f0c",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll find the rope.",
                "Next": "accepted",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Who rang it the first time?",
                "Next": "who",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "We have the rope.",
                "Next": "done",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Ring your own bell.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "who",
            "Line": {
              "Text": "Everyone asks. Nobody knows. The water came in the night and the bell was ringing and by morning there was nobody to ask. I\u0027m sorry. Would you look for the rope?",
              "VoiceId": "86ee5fca51c41456",
              "Delivery": "whisper"
            },
            "Choices": [
              {
                "Text": "We\u0027ll find the rope.",
                "Next": "accepted",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Later.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Thank you. The peal gallery, the sounding board, the drowned step. It was cut short, the rope. Somebody small was meant to reach it.",
              "VoiceId": "645bcee3caf80774",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "That\u0027s it. That\u0027s the knot. I tied that knot, I was nine, I couldn\u0027t reach and the Company man tied the rest and gave me the lantern seal to hold and said ring, Ambrose, ring and the debt goes away. I\u0027m sorry. I\u0027m so sor",
              "VoiceId": "c749c9f2f0a217bd",
              "Delivery": "whisper"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "quest_rope",
      "CastId": "cast_bell",
      "Persona": {
        "VoiceStyle": "a soft, guilty man, every sentence half an apology",
        "DefaultDelivery": "pleading",
        "Voice": "Enceladus",
