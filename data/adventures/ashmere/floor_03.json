      },
      "Lines": {
        "Offer": {
          "Text": "They tore the first page in three. Fetch the pieces and I\u0027ll read it you.",
          "VoiceId": "e47800dd800876eb",
          "Delivery": null
        },
        "Accept": {
          "Text": "Good. Don\u0027t let the clerks count you.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Then I\u0027ll map without you. I usually do.",
          "VoiceId": null,
          "Delivery": "weary"
        },
        "Complete": {
          "Text": "\u0027Settled by water.\u0027 Well. That\u0027s Mill Lane for you.",
          "VoiceId": "bd6d401ccae57bbf",
          "Delivery": "calm"
        },
        "Fail": {
          "Text": "Pages don\u0027t keep down here. Nor do people.",
          "VoiceId": null,
          "Delivery": "weary"
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
