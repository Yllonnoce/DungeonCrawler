  "Npcs": [
    {
      "Id": "npc_nan",
      "Name": "Nan Trellick",
      "Room": 1,
      "VoiceId": "Kore",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Mind the kerb, dear, this is Tallow Street. Well, it was. I\u0027m mapping it. You\u0027ll want the counting house\u0027s first page; they tore it in three, the cowards. Fetch the pieces and I\u0027ll read it you.",
              "VoiceId": "6c65724a467ce670",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll find the pieces.",
                "Next": "accepted",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "This isn\u0027t a street. It\u0027s a tunnel.",
                "Next": "street",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "We have the pieces.",
                "Next": "done",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Another time, Nan.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "street",
            "Line": {
              "Text": "Tunnel. Street. It\u0027s all a matter of what\u0027s on top of you, and I\u0027ve never let that stop me. Here, look: the baker\u0027s was there, the Company office there. The office is the one that\u0027s still lit.",
              "VoiceId": "2b80d4b4d90dc1ee",
              "Delivery": "cheerful"
            },
            "Choices": [
              {
                "Text": "We\u0027ll find the pieces.",
                "Next": "accepted",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Later.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Good. They\u0027ll be where clerks hide things: under the row, in the blotter, in the tally room. Don\u0027t let the clerks see you. They count you if they see you.",
              "VoiceId": "82b097b00f606363",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "Here we are. \u0027Ashmere, the whole of it, owes the Lamplighters\u0027 Company...\u0027 a sum, my word, a sum. And under it: \u0027settled by water.\u0027 Settled by water. Well. That\u0027s Mill Lane for you, always flooding.",
              "VoiceId": "7af3fd1a8236a28f",
              "Delivery": "calm"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "quest_ledger",
      "CastId": "cast_nan",
      "Persona": {
        "VoiceStyle": "a brisk old woman who talks over you and gets every street wrong with total confidence",
        "DefaultDelivery": "warm",
        "Voice": "Kore",
        "IsEmpty": false
      },
      "RequiresFlag": null,
