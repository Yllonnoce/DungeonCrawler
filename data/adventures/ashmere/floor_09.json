  "Quests": [
    {
      "Id": "quest_manifest",
      "Template": "Investigate",
      "Title": "The Captain\u0027s Manifests",
      "Objective": "Gather Ottilie Vane\u0027s three crew manifests from the galleries and bring them to her fire.",
      "Params": {
        "TargetCollective": null,
        "ItemName": null,
        "ItemRoom": null,
        "EscortNpc": null,
        "Waves": null,
        "WaveCollective": null,
        "ClueRooms": [
