  "Npcs": [
    {
      "Id": "npc_ottilie",
      "Name": "Ottilie Vane",
      "Room": 8,
      "VoiceId": "Enceladus",
      "Script": {
        "Start": "greet",
        "Nodes": [
          {
            "Id": "greet",
            "Line": {
              "Text": "Ha. The Company\u0027s four. Ottilie Vane, captain of what\u0027s left. Do me a turn: my crew\u0027s manifests are scattered up the galleries, and I want them before the clerk reads them out. He does that. Reads things out.",
              "VoiceId": "01d2d1e5adc53bb5",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "We\u0027ll fetch them.",
                "Next": "accepted",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "What\u0027s left of your crew?",
                "Next": "crew",
                "Effect": "None",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "We have your manifests.",
                "Next": "done",
                "Effect": "TurnIn",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Fetch your own papers.",
                "Next": null,
                "Effect": "DeclineQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "crew",
            "Line": {
              "Text": "Four of eleven. The toll\u0027s steep down here and I\u0027m bad at sums. Don\u0027t look at me like that. You\u0027ll be bad at sums too, by the belfry.",
              "VoiceId": "6ca33b5b906d6532",
              "Delivery": "weary"
            },
            "Choices": [
              {
                "Text": "We\u0027ll fetch them.",
                "Next": "accepted",
                "Effect": "AcceptQuest",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              },
              {
                "Text": "Later, captain.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "accepted",
            "Line": {
              "Text": "Good. Three sheets: the cache, the tally gallery, the far seam. Mind the brood, they like paper. They like anything.",
              "VoiceId": "e968d065d681f1c2",
              "Delivery": null
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          },
          {
            "Id": "done",
            "Line": {
              "Text": "Give them here. Yes. Yes, that\u0027s... eleven names struck through, and here they are again under \u0027passage paid to the Toll-Keeper\u0027. In my hand. Ha! Well. Ha. I told you I was bad at sums.",
              "VoiceId": "6ae1a390f80fb0f6",
              "Delivery": "weary"
            },
            "Choices": [
              {
                "Text": "Farewell.",
                "Next": null,
                "Effect": "Farewell",
                "Flag": null,
                "RequiresFlag": null,
                "ForbidsFlag": null
              }
            ]
          }
        ]
      },
      "QuestId": "quest_manifest",
      "CastId": "cast_ottilie",
      "Persona": {
        "VoiceStyle": "a hoarse, swaggering captain who laughs at her own bad luck before you can",
        "DefaultDelivery": "sly",
        "Voice": "Gacrux",
        "IsEmpty": false
      },
      "RequiresFlag": null,
      "ForbidsFlag": null,
      "Betrayal": null
    }
