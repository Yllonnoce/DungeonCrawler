      },
      "GiverNpc": "npc_ottilie",
      "Reward": {
        "Xp": 250,
        "Table": "table.chest"
      },
      "Lines": {
        "Offer": {
          "Text": "My crew\u0027s manifests are scattered up the galleries. I want them before the clerk reads them out.",
          "VoiceId": "305753780ac16731",
          "Delivery": null
        },
        "Accept": {
          "Text": "Three sheets. Mind the brood.",
          "VoiceId": null,
          "Delivery": null
        },
        "Decline": {
          "Text": "Then he\u0027ll read them. He reads everything.",
          "VoiceId": null,
          "Delivery": "weary"
        },
        "Complete": {
          "Text": "Eleven names struck through and written again as \u0027passage paid\u0027. In my hand. I told you I was bad at sums.",
          "VoiceId": "b9c3193951c1e387",
          "Delivery": "weary"
        },
        "Fail": {
          "Text": "Paper doesn\u0027t keep down here. Nor does a crew.",
          "VoiceId": null,
          "Delivery": "weary"
        }
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
  ],
  "Narration": [
    {
      "Trigger": "QuestDone",
      "Room": null,
      "Line": {
        "Text": "The captain feeds the manifests to her fire, one sheet at a time, and does not look up. Somewhere below, the clerk laughs, and it carries.",
        "VoiceId": "a5b8c5f4fb8c166e",
        "Delivery": null
      },
      "RequiresFlag": null,
      "ForbidsFlag": null
    }
