<?xml version="1.0" encoding="utf-8"?>
<!-- Where the build fetches Godot.NET.Sdk and the packages the csproj names. Declared here so a machine whose user-level
     NuGet config has no sources (seen on Windows) still builds; without a source the SDK resolver fails with MSB4236. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
