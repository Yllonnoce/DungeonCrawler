<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>DungeonCrawler.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Engine-free game logic compiled directly into the test assembly.
         Anything listed here must never reference the Godot namespace. -->
    <Compile Include="../src/Core/Rng.cs" Link="Game/Core/Rng.cs" />
    <Compile Include="../src/Core/GripMath.cs" Link="Game/Core/GripMath.cs" />
    <Compile Include="../src/Core/ViewerGait.cs" Link="Game/Core/ViewerGait.cs" />
    <Compile Include="../src/Characters/*.cs" Link="Game/Characters/%(Filename)%(Extension)" />
    <Compile Include="../src/Characters/Skills/*.cs" Link="Game/Characters/Skills/%(Filename)%(Extension)" />
    <Compile Include="../src/Characters/Companions/*.cs" Link="Game/Characters/Companions/%(Filename)%(Extension)" />
    <Compile Include="../src/Combat/Core/**/*.cs" Link="Game/Combat/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../src/Items/ItemInstance.cs" Link="Game/Items/ItemInstance.cs" />
    <Compile Include="../src/Items/Inventory.cs" Link="Game/Items/Inventory.cs" />
    <Compile Include="../src/Items/WeaponProfile.cs" Link="Game/Items/WeaponProfile.cs" />
    <Compile Include="../src/Items/Core/**/*.cs" Link="Game/Items/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../src/Dungeon/Generation/**/*.cs" Link="Game/Dungeon/Generation/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../src/Dungeon/ExplorationMap.cs" Link="Game/Dungeon/ExplorationMap.cs" />
    <Compile Include="../src/Dungeon/TierRules.cs" Link="Game/Dungeon/TierRules.cs" />
    <Compile Include="../src/Dungeon/TierProfile.cs" Link="Game/Dungeon/TierProfile.cs" />
    <Compile Include="../src/Adventure/Core/**/*.cs" Link="Game/Adventure/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../src/Dungeon/TrapRules.cs" Link="Game/Dungeon/TrapRules.cs" />
    <Compile Include="../src/Dungeon/VaultRules.cs" Link="Game/Dungeon/VaultRules.cs" />
    <Compile Include="../src/Enemies/Core/**/*.cs" Link="Game/Enemies/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../src/Save/Core/**/*.cs" Link="Game/Save/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../src/Party/Core/**/*.cs" Link="Game/Party/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../src/Net/Core/**/*.cs" Link="Game/Net/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
