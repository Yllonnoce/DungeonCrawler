{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "DungeonCrawler.csproj", "--nologo", "-clp:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "dotnet",
      "args": ["test", "tests/DungeonCrawler.Tests.csproj", "--nologo"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "import assets",
      "type": "shell",
      "command": "godot",
      "args": ["--headless", "--import", "--path", "${workspaceFolder}"],
      "problemMatcher": []
    }
  ]
}
