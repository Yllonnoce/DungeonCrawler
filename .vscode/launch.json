{
  // F5 from either side of the dual boot. Linux runs ~/.local/bin/godot; Windows runs the Godot 4.7.2 .NET console build
  // that build.bat fetches into %LOCALAPPDATA%\DungeonCrawlerTools (run build.bat once, or edit the "windows" paths to
  // your own copy). Godot .NET finds its runtime by running "dotnet --list-sdks" and crashes at startup without one, so
  // the Windows entries put the private .NET 8 SDK build.bat fetched in front of PATH (harmless when a system SDK exists).
  // The "build" task before each launch is scripts/dotnet.bat on Windows: the .NET 8 SDK on PATH, else that private copy.
  // nuget.config at the repository root gives the build its package source.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${env:HOME}/.local/bin/godot",
      "windows": {
        "program": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\Godot_v4.7.2-stable_mono_win64\\Godot_v4.7.2-stable_mono_win64_console.exe",
        "env": { "PATH": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\dotnet;${env:PATH}" }
      },
      "args": ["--path", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Play (builtin campaign)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${env:HOME}/.local/bin/godot",
      "windows": {
        "program": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\Godot_v4.7.2-stable_mono_win64\\Godot_v4.7.2-stable_mono_win64_console.exe",
        "env": { "PATH": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\dotnet;${env:PATH}" }
      },
      "args": ["--path", "${workspaceFolder}", "--", "--builtin"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Play (seed + floor)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${env:HOME}/.local/bin/godot",
      "windows": {
        "program": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\Godot_v4.7.2-stable_mono_win64\\Godot_v4.7.2-stable_mono_win64_console.exe",
        "env": { "PATH": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\dotnet;${env:PATH}" }
      },
      "args": ["--path", "${workspaceFolder}", "--", "--seed=${input:seed}", "--floor=${input:floor}"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Headless smoke",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${env:HOME}/.local/bin/godot",
      "windows": {
        "program": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\Godot_v4.7.2-stable_mono_win64\\Godot_v4.7.2-stable_mono_win64_console.exe",
        "env": { "PATH": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\dotnet;${env:PATH}" }
      },
      "args": ["--headless", "--path", "${workspaceFolder}", "--", "--smoke"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Headless (custom args)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${env:HOME}/.local/bin/godot",
      "windows": {
        "program": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\Godot_v4.7.2-stable_mono_win64\\Godot_v4.7.2-stable_mono_win64_console.exe",
        "env": { "PATH": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\dotnet;${env:PATH}" }
      },
      "args": ["--headless", "--path", "${workspaceFolder}", "--", "${input:gameArgs}"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Dedicated server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${env:HOME}/.local/bin/godot",
      "windows": {
        "program": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\Godot_v4.7.2-stable_mono_win64\\Godot_v4.7.2-stable_mono_win64_console.exe",
        "env": { "PATH": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\dotnet;${env:PATH}" }
      },
      "args": ["--headless", "--path", "${workspaceFolder}", "--", "--server", "--port=7777", "--bind=127.0.0.1", "--campaign=builtin", "--save=server", "--max-players=4"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Editor",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${env:HOME}/.local/bin/godot",
      "windows": {
        "program": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\Godot_v4.7.2-stable_mono_win64\\Godot_v4.7.2-stable_mono_win64_console.exe",
        "env": { "PATH": "${env:LOCALAPPDATA}\\DungeonCrawlerTools\\dotnet;${env:PATH}" }
      },
      "args": ["-e", "--path", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Attach to running game",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ],
  "inputs": [
    { "id": "seed", "type": "promptString", "description": "Run seed", "default": "1" },
    { "id": "floor", "type": "promptString", "description": "Floor to start on", "default": "1" },
    { "id": "gameArgs", "type": "promptString", "description": "Game argument after the -- (see README: --test-depth, --test-party, --builtin ...)", "default": "--test-depth" }
  ]
}
