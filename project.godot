; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="DungeonCrawler"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

EventBus="*res://src/Core/EventBus.cs"
Registry="*res://src/Core/Registry.cs"
Game="*res://src/Core/Game.cs"
NetSession="*res://src/Net/NetSession.cs"
AdventureDirector="*res://src/Adventure/AdventureDirector.cs"
DebugTools="*res://src/Core/DebugTools.cs"
AudioManager="*res://src/Audio/AudioManager.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="DungeonCrawler"

